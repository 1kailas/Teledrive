                                                                <FontIcon FontSize="13" Foreground="#2DD4BF" Glyph="&#xE896;" />
                                                            </Button>
                                                            <Button
                                                                Background="Transparent"
                                                                BorderThickness="0"
                                                                Padding="4"
                                                                Click="FileStarBtn_Click"
                                                                ToolTipService.ToolTip="Star File">
                                                                <FontIcon
                                                                    FontSize="13"
                                                                    Foreground="#F59E0B"
                                                                    Glyph="{x:Bind StarGlyph, Mode=OneWay}" />
                                                            </Button>
                                                        </StackPanel>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ListView.ItemTemplate>
                                    </ListView>
                                </StackPanel>

                                <!-- Empty State -->
                                <StackPanel
                                    x:Name="EmptyState"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Margin="0,64,0,0"
