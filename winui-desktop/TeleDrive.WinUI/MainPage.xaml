<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="TeleDrive_WinUI.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:TeleDrive_WinUI"
    xmlns:models="using:TeleDrive_WinUI.Models"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    KeyDown="MainPage_KeyDown">

    <Grid
        Background="{ThemeResource LayerFillColorDefaultBrush}"
        AllowDrop="True"
        DragOver="Common_DragOver"
        DragLeave="Common_DragLeave"
        Drop="Common_Drop">

        <!-- Windows 11 Fluent NavigationView -->
        <NavigationView
            x:Name="NavView"
            IsBackButtonVisible="Collapsed"
            IsSettingsVisible="True"
            OpenPaneLength="240"
            CompactPaneLength="48"
            PaneDisplayMode="Auto"
            IsPaneOpen="True"
            CompactModeThresholdWidth="640"
            ExpandedModeThresholdWidth="1008"
            PaneOpened="NavView_PaneOpened"
            PaneClosed="NavView_PaneClosed"
            SelectionChanged="NavView_SelectionChanged"
            ItemInvoked="NavView_ItemInvoked">
            
            <NavigationView.MenuItems>
                <NavigationViewItem x:Name="DriveNavItem" Tag="drive" Content="My Drive">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE8B7;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Tag="folder_documents" Content="Documents">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE8A5;" Foreground="#10B981" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Tag="folder_pictures" Content="Pictures">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xEB9F;" Foreground="#38BDF8" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Tag="folder_videos" Content="Videos">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE714;" Foreground="#A855F7" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Tag="folder_music" Content="Music">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xEC4F;" Foreground="#EC4899" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>

                <NavigationViewItemSeparator />

                <NavigationViewItem Tag="starred" Content="Starred">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE734;" Foreground="#F59E0B" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Tag="recent" Content="Recent Activity">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE823;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>

                <NavigationViewItemSeparator />

                <NavigationViewItem x:Name="TransfersNavItem" Tag="transfers" Content="Transfers Hub">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE896;" Foreground="#2DD4BF" />
                    </NavigationViewItem.Icon>
                    <NavigationViewItem.InfoBadge>
                        <InfoBadge x:Name="TransfersBadge" Visibility="Collapsed" Value="0" />
                    </NavigationViewItem.InfoBadge>
                </NavigationViewItem>
                
                <NavigationViewItem Tag="trash" Content="Trash">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE74D;" Foreground="#EF4444" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.MenuItems>

            <!-- Main Content Area -->
            <Grid x:Name="ContentRoot" Padding="24,16,24,8" SizeChanged="ContentRoot_SizeChanged">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Header: Explorer-style address bar + command bar -->
                <Grid Grid.Row="0" Margin="0,0,0,12" RowSpacing="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Address row: back, path (breadcrumbs), search -->
                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <Button
                            x:Name="NavBackBtn"
                            Grid.Column="0"
                            Width="32"
                            Height="32"
                            Margin="0,0,8,0"
                            Padding="0"
                            Click="NavBackBtn_Click"
                            Visibility="Collapsed"
                            ToolTipService.ToolTip="Back"
                            AutomationProperties.Name="Back">
                            <FontIcon Glyph="&#xE72B;" FontSize="14" />
                        </Button>

                        <Border
                            x:Name="AddressBar"
                            Grid.Column="1"
                            Height="32"
                            Padding="2,0"
                            CornerRadius="6"
                            Background="{ThemeResource ControlFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            Tapped="AddressBar_Tapped">
                            <Grid x:Name="AddressCrumbsHost" VerticalAlignment="Center" SizeChanged="AddressCrumbsHost_SizeChanged">
                                <StackPanel x:Name="BreadcrumbsBarStack" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Left" Spacing="0" />
                                <TextBlock x:Name="CurrentFolderTitle" Visibility="Collapsed" Text="My Drive" />
                                <TextBox
                                    x:Name="AddressEditBox"
                                    Visibility="Collapsed"
                                    VerticalAlignment="Center"
                                    Height="28"
                                    MinHeight="28"
                                    FontSize="13"
                                    PlaceholderText="My Drive/Folder/Subfolder"
                                    KeyDown="AddressEditBox_KeyDown"
                                    LostFocus="AddressEditBox_LostFocus" />
                            </Grid>
                        </Border>

                        <AutoSuggestBox
                            x:Name="SearchBox"
                            Grid.Column="2"
                            Width="240"
                            Margin="8,0,0,0"
                            PlaceholderText="Search in this folder"
                            QueryIcon="Find"
                            VerticalAlignment="Center"
                            TextChanged="SearchBox_TextChanged" />
                    </Grid>

                    <!-- Command row -->
                    <Grid Grid.Row="1" ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel x:Name="HeaderActionsPanel" Orientation="Horizontal" Spacing="8">
                            <Button
                                x:Name="UploadFilesBtn"
                                Style="{StaticResource AccentButtonStyle}"
                                ToolTipService.ToolTip="Upload files to this folder"
                                AutomationProperties.Name="Upload files"
                                Click="UploadFilesBtn_Click">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon Glyph="&#xE898;" FontSize="14" />
                                    <TextBlock x:Name="UploadFilesLabel" Text="Upload Files" />
                                </StackPanel>
                            </Button>

                            <Button
                                x:Name="UploadFolderBtn"
                                ToolTipService.ToolTip="Upload a folder to this folder"
                                AutomationProperties.Name="Upload folder"
                                Click="UploadFolderBtn_Click">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon Glyph="&#xED25;" FontSize="14" />
                                    <TextBlock x:Name="UploadFolderLabel" Text="Upload Folder" />
                                </StackPanel>
                            </Button>

                            <Button x:Name="NewFolderBtn" ToolTipService.ToolTip="New folder" AutomationProperties.Name="New folder" Click="NewFolderBtn_Click">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon Glyph="&#xE8F4;" FontSize="14" />
                                    <TextBlock x:Name="NewFolderLabel" Text="New Folder" />
                                </StackPanel>
                            </Button>

                            <Button
                                x:Name="EmptyTrashBtn"
                                Style="{StaticResource AccentButtonStyle}"
                                Background="#DC2626"
                                Click="EmptyTrashBtn_Click"
                                Visibility="Collapsed"
                                ToolTipService.ToolTip="Permanently delete all items in trash and purge the stored messages from Telegram">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon Glyph="&#xE74D;" FontSize="14" />
                                    <TextBlock x:Name="EmptyTrashLabel" Text="Empty Trash" />
                                </StackPanel>
                            </Button>

                            <Button x:Name="RefreshToolbarBtn" ToolTipService.ToolTip="Refresh (F5)" AutomationProperties.Name="Refresh" Click="RefreshBtn_Click">
                                <FontIcon Glyph="&#xE72C;" FontSize="14" />
                            </Button>

                            <Border x:Name="SelectionSeparator" Width="1" Margin="4,6" Background="{ThemeResource DividerStrokeColorDefaultBrush}" Visibility="Collapsed" />

                            <StackPanel x:Name="SelectionCommands" Orientation="Horizontal" Spacing="8" Visibility="Collapsed">
                            <Button x:Name="RenameSelBtn" Click="RenameSelected_Click" ToolTipService.ToolTip="Rename (F2)" AutomationProperties.Name="Rename" Visibility="Collapsed">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon Glyph="&#xE8AC;" FontSize="14" />
                                    <TextBlock x:Name="SelRenameLabel" Text="Rename" Visibility="Collapsed" />
                                </StackPanel>
                            </Button>
                            <Button x:Name="MoveSelBtn" Click="ContextMenu_MoveItem_Click" ToolTipService.ToolTip="Move to another folder" AutomationProperties.Name="Move to" Visibility="Collapsed">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon Glyph="&#xE8DE;" FontSize="14" />
                                    <TextBlock x:Name="SelMoveLabel" Text="Move to" Visibility="Collapsed" />
                                </StackPanel>
                            </Button>
                            <Button x:Name="DownloadSelBtn" Click="DetailsDownloadBtn_Click" ToolTipService.ToolTip="Download the selected files" AutomationProperties.Name="Download" Visibility="Collapsed">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon Glyph="&#xE896;" FontSize="14" />
                                    <TextBlock x:Name="SelDownloadLabel" Text="Download" Visibility="Collapsed" />
                                </StackPanel>
                            </Button>
                            <Button x:Name="TrashSelBtn" Click="DetailsTrashBtn_Click" ToolTipService.ToolTip="Move to Trash (Delete)" AutomationProperties.Name="Trash" Visibility="Collapsed">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon Glyph="&#xE74D;" FontSize="14" />
                                    <TextBlock x:Name="SelTrashLabel" Text="Trash" Visibility="Collapsed" />
                                </StackPanel>
                            </Button>
                            <Button x:Name="RestoreSelBtn" Click="DetailsRestoreBtn_Click" ToolTipService.ToolTip="Restore the selected items" AutomationProperties.Name="Restore" Visibility="Collapsed">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon Glyph="&#xE7A7;" FontSize="14" />
                                    <TextBlock x:Name="SelRestoreLabel" Text="Restore" Visibility="Collapsed" />
                                </StackPanel>
                            </Button>
                            <Button x:Name="DeleteForeverSelBtn" Click="DetailsDeletePermanentlyBtn_Click" ToolTipService.ToolTip="Permanently delete the selected items" AutomationProperties.Name="Delete forever" Visibility="Collapsed">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon Glyph="&#xE74D;" FontSize="14" />
                                    <TextBlock x:Name="SelDeleteLabel" Text="Delete forever" Visibility="Collapsed" />
                                </StackPanel>
                            </Button>
                            </StackPanel>

                        </StackPanel>

                        <TextBlock
                            x:Name="ItemCountSubtitle"
                            Grid.Column="1"
                            VerticalAlignment="Center"
                            FontSize="12"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Text="" />
                    </Grid>
                </Grid>

                <!-- Loading indicator + service connection banner -->
                <StackPanel Grid.Row="1" Spacing="8">
                    <ProgressBar
                        x:Name="LoadingBar"
                        IsIndeterminate="True"
                        Visibility="Collapsed"
                        Margin="0,-8,0,0" />
                    <InfoBar
                        x:Name="ServiceBanner"
                        IsOpen="False"
                        IsClosable="False"
                        Severity="Error"
                        Title="Can't reach the local TeleDrive service"
                        Message="Files can't be listed or transferred until it's running again."
                        Margin="0,0,0,8">
                        <InfoBar.ActionButton>
                            <Button Content="Retry" Click="ServiceBannerRetry_Click" />
                        </InfoBar.ActionButton>
                    </InfoBar>
                </StackPanel>

                <!-- Split Content: Files Area (Left) + Properties Drawer (Right) -->
                <Grid Grid.Row="2" ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- Left: Main Views Container -->
                    <Grid Grid.Column="0">
                        <!-- Content Area: Drive / Files View -->
                        <ScrollViewer
                            x:Name="DriveScrollViewer"
                            Padding="0,0,4,0"
                            Margin="0"
                            AllowDrop="True"
                            DragOver="Common_DragOver"
                            DragLeave="Common_DragLeave"
                            Drop="Common_Drop"
                            HorizontalScrollBarVisibility="Disabled"
                            VerticalScrollBarVisibility="Auto"
                            SizeChanged="DriveScrollViewer_SizeChanged"
                            Tapped="DriveScrollViewer_Tapped"
                            PointerWheelChanged="DriveScrollViewer_PointerWheelChanged">
                            <ScrollViewer.ContextFlyout>
                                <MenuFlyout>
                                    <MenuFlyoutItem Text="Upload Files..." Click="UploadFilesBtn_Click">
                                        <MenuFlyoutItem.Icon>
                                            <FontIcon Glyph="&#xE898;" Foreground="#38BDF8" />
                                        </MenuFlyoutItem.Icon>
                                    </MenuFlyoutItem>
                                    <MenuFlyoutItem Text="Upload Folder..." Click="UploadFolderBtn_Click">
                                        <MenuFlyoutItem.Icon>
                                            <FontIcon Glyph="&#xED25;" Foreground="#38BDF8" />
                                        </MenuFlyoutItem.Icon>
                                    </MenuFlyoutItem>
                                    <MenuFlyoutSeparator />
                                    <MenuFlyoutItem Text="New Folder..." Click="NewFolderBtn_Click">
                                        <MenuFlyoutItem.Icon>
                                            <FontIcon Glyph="&#xE8F4;" />
                                        </MenuFlyoutItem.Icon>
                                    </MenuFlyoutItem>
                                    <MenuFlyoutSeparator />
                                    <MenuFlyoutItem Text="Paste (Ctrl+V)" Click="ContextMenu_Paste_Click">
                                        <MenuFlyoutItem.Icon>
                                            <FontIcon Glyph="&#xE77F;" Foreground="#38BDF8" />
                                        </MenuFlyoutItem.Icon>
                                    </MenuFlyoutItem>
                                    <MenuFlyoutSeparator />
                                    <MenuFlyoutItem Text="Refresh (F5)" Click="RefreshBtn_Click">
                                        <MenuFlyoutItem.Icon>
                                            <FontIcon Glyph="&#xE72C;" />
                                        </MenuFlyoutItem.Icon>
                                    </MenuFlyoutItem>
                                </MenuFlyout>
                            </ScrollViewer.ContextFlyout>
                            <StackPanel Spacing="24">
                                <!-- Folders Section -->
                                <StackPanel x:Name="FoldersSection" Spacing="8">
                                    <TextBlock
                                        FontSize="12"
                                        FontWeight="SemiBold"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Text="FOLDERS" />
                                    <GridView
                                        x:Name="FoldersGridView"
                                        Padding="0"
                                        Margin="-4,0,0,0"
                                        HorizontalAlignment="Left"
                                        DoubleTapped="FoldersGridView_DoubleTapped"
                                        SelectionMode="Extended"
                                        SelectionChanged="FoldersGridView_SelectionChanged"
                                        Loaded="FoldersGridView_Loaded"
                                        KeyDown="FilesOrFolders_KeyDown">
                                        <GridView.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <ItemsWrapGrid Orientation="Horizontal" HorizontalAlignment="Left" MaximumRowsOrColumns="-1" ItemWidth="215" ItemHeight="60" />
                                            </ItemsPanelTemplate>
                                        </GridView.ItemsPanel>
                                        <GridView.ItemContainerStyle>
                                            <Style TargetType="GridViewItem">
                                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                                <Setter Property="VerticalContentAlignment" Value="Stretch" />
                                                <Setter Property="MinHeight" Value="0" />
                                                <Setter Property="MinWidth" Value="0" />
                                                <Setter Property="Margin" Value="4" />
                                                <Setter Property="Padding" Value="0" />
                                            </Style>
                                        </GridView.ItemContainerStyle>
                                        <GridView.ItemTemplate>
                                            <DataTemplate x:DataType="models:FolderModel">
                                                <Border
                                                    Padding="12,8"
                                                    HorizontalAlignment="Stretch"
                                                    VerticalAlignment="Stretch"
                                                    Background="{x:Bind SelectionBackground, Mode=OneWay}"
                                                    BorderBrush="{x:Bind SelectionBorderBrush, Mode=OneWay}"
                                                    BorderThickness="{x:Bind SelectionBorderThickness, Mode=OneWay}"
                                                    CornerRadius="8">
                                                    <Border.ContextFlyout>
                                                        <MenuFlyout>
                                                            <MenuFlyoutItem Text="Open Folder" Click="ContextMenu_OpenFolder_Click">
                                                                <MenuFlyoutItem.Icon>
                                                                    <FontIcon Glyph="&#xE8DA;" Foreground="#38BDF8" />
                                                                </MenuFlyoutItem.Icon>
                                                            </MenuFlyoutItem>
                                                            <MenuFlyoutItem Text="Star" Click="FolderStarBtn_Click">
                                                                <MenuFlyoutItem.Icon>
                                                                    <FontIcon Glyph="&#xE734;" Foreground="#F59E0B" />
                                                                </MenuFlyoutItem.Icon>
                                                            </MenuFlyoutItem>
                                                            <MenuFlyoutItem Text="Rename..." Click="ContextMenu_RenameFolder_Click">
                                                                <MenuFlyoutItem.Icon>
                                                                    <FontIcon Glyph="&#xE8AC;" />
                                                                </MenuFlyoutItem.Icon>
                                                            </MenuFlyoutItem>
                                                            <MenuFlyoutSeparator />
                                                            <MenuFlyoutItem Text="Cut (Ctrl+X)" Click="ContextMenu_CutFolder_Click">
                                                                <MenuFlyoutItem.Icon>
                                                                    <FontIcon Glyph="&#xE8C6;" />
                                                                </MenuFlyoutItem.Icon>
                                                            </MenuFlyoutItem>
                                                            <MenuFlyoutItem Text="Copy (Ctrl+C)" Click="ContextMenu_CopyFolder_Click">
                                                                <MenuFlyoutItem.Icon>
                                                                    <FontIcon Glyph="&#xE8C8;" />
                                                                </MenuFlyoutItem.Icon>
                                                            </MenuFlyoutItem>
                                                            <MenuFlyoutItem Text="Move to..." Click="ContextMenu_MoveItem_Click">
                                                                <MenuFlyoutItem.Icon>
                                                                    <FontIcon Glyph="&#xE8DE;" Foreground="#38BDF8" />
                                                                </MenuFlyoutItem.Icon>
                                                            </MenuFlyoutItem>
                                                            <MenuFlyoutItem Text="Paste into folder" Click="ContextMenu_PasteIntoFolder_Click">
                                                                <MenuFlyoutItem.Icon>
                                                                    <FontIcon Glyph="&#xE77F;" Foreground="#38BDF8" />
                                                                </MenuFlyoutItem.Icon>
                                                            </MenuFlyoutItem>
                                                            <MenuFlyoutSeparator />
                                                            <MenuFlyoutItem Text="Move to Trash" Click="ContextMenu_TrashFolder_Click">
                                                                <MenuFlyoutItem.Icon>
                                                                    <FontIcon Glyph="&#xE74D;" Foreground="#F43F5E" />
                                                                </MenuFlyoutItem.Icon>
                                                            </MenuFlyoutItem>
                                                        </MenuFlyout>
                                                    </Border.ContextFlyout>
                                                    <Grid ColumnSpacing="10" VerticalAlignment="Center">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>

                                                        <FontIcon
                                                            Grid.Column="0"
                                                            FontSize="22"
                                                            Foreground="{x:Bind FolderBrush, Mode=OneWay}"
                                                            Glyph="{x:Bind FolderGlyph, Mode=OneWay}"
                                                            VerticalAlignment="Center" />

                                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                                            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                                                <TextBlock
                                                                    FontWeight="SemiBold"
                                                                    FontSize="12.5"
                                                                    MaxLines="1"
                                                                    Text="{x:Bind Name}"
                                                                    TextTrimming="CharacterEllipsis"
                                                                    VerticalAlignment="Center" />
                                                                <Border
                                                                    Visibility="{x:Bind SeriesBadgeVisibility, Mode=OneWay}"
                                                                    Background="#1E1B4B"
                                                                    BorderBrush="#4338CA"
                                                                    BorderThickness="1"
                                                                    CornerRadius="4"
                                                                    Padding="4,0.5"
                                                                    VerticalAlignment="Center">
                                                                    <TextBlock
                                                                        FontSize="9"
                                                                        FontWeight="Bold"
                                                                        Foreground="#818CF8"
                                                                        Text="{x:Bind SeriesBadgeText, Mode=OneWay}" />
                                                                </Border>
                                                            </StackPanel>
                                                            <TextBlock
                                                                FontSize="11"
                                                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                                Text="{x:Bind FormattedItemCount, Mode=OneWay}"
                                                                VerticalAlignment="Center" />
                                                        </StackPanel>

                                                        <!-- Selection indicator checkmark badge -->
                                                        <Border
                                                            Grid.Column="2"
                                                            Width="16"
                                                            Height="16"
                                                            CornerRadius="8"
                                                            Background="#38BDF8"
                                                            Visibility="{x:Bind SelectionCheckmarkVisibility, Mode=OneWay}"
                                                            VerticalAlignment="Center">
                                                            <FontIcon
                                                                Glyph="&#xE73E;"
                                                                FontSize="9"
                                                                Foreground="Black"
                                                                HorizontalAlignment="Center"
                                                                VerticalAlignment="Center" />
                                                        </Border>

                                                        <Button
                                                            Grid.Column="3"
                                                            Width="24"
                                                            Height="24"
                                                            Background="Transparent"
                                                            BorderThickness="0"
                                                            Padding="0"
                                                            CornerRadius="4"
                                                            VerticalAlignment="Center"
                                                            Click="FolderStarBtn_Click">
                                                            <FontIcon
                                                                FontSize="11"
                                                                Foreground="#F59E0B"
                                                                Glyph="{x:Bind StarGlyph, Mode=OneWay}" />
                                                        </Button>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </GridView.ItemTemplate>
                                    </GridView>
                                </StackPanel>

                                <!-- Files Section (Grid View) -->
                                <StackPanel x:Name="FilesGridSection" Spacing="8">
                                    <TextBlock
                                        FontSize="12"
                                        FontWeight="SemiBold"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Text="FILES" />
                                    <GridView
                                        x:Name="FilesGridView"
                                        Padding="0"
                                        Margin="-4,0,0,0"
                                        HorizontalAlignment="Left"
                                        AllowDrop="True"
                                        DragOver="Common_DragOver"
                                        DragLeave="Common_DragLeave"
                                        Drop="Common_Drop"
                                        DoubleTapped="FilesGridView_DoubleTapped"
                                        SelectionMode="Extended"
                                        SelectionChanged="FilesGridView_SelectionChanged"
                                        Loaded="FilesGridView_Loaded"
                                        KeyDown="FilesOrFolders_KeyDown">
                                        <GridView.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <ItemsWrapGrid Orientation="Horizontal" HorizontalAlignment="Left" MaximumRowsOrColumns="-1" ItemWidth="165" ItemHeight="168" />
                                            </ItemsPanelTemplate>
                                        </GridView.ItemsPanel>
                                        <GridView.ItemContainerStyle>
                                            <Style TargetType="GridViewItem">
                                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                                <Setter Property="VerticalContentAlignment" Value="Stretch" />
                                                <Setter Property="MinHeight" Value="0" />
                                                <Setter Property="MinWidth" Value="0" />
                                                <Setter Property="Margin" Value="4" />
                                                <Setter Property="Padding" Value="0" />
                                            </Style>
                                        </GridView.ItemContainerStyle>
                                        <GridView.ItemTemplate>
                                            <DataTemplate x:DataType="models:FileModel">
                                                <Border
                                                    HorizontalAlignment="Stretch"
                                                    VerticalAlignment="Stretch"
                                                    Padding="6"
                                                    Background="{x:Bind SelectionBackground, Mode=OneWay}"
                                                    BorderBrush="{x:Bind SelectionBorderBrush, Mode=OneWay}"
                                                    BorderThickness="{x:Bind SelectionBorderThickness, Mode=OneWay}"
                                                    CornerRadius="8">
                                                    <Border.ContextFlyout>
                                                        <MenuFlyout>
                                                            <MenuFlyoutItem Text="Download to Device" Click="ContextMenu_Download_Click">
                                                                <MenuFlyoutItem.Icon>
                                                                    <FontIcon Glyph="&#xE896;" Foreground="#2DD4BF" />
                                                                </MenuFlyoutItem.Icon>
                                                            </MenuFlyoutItem>
                                                            <MenuFlyoutItem Text="Copy ID" Click="ContextMenu_CopyId_Click">
                                                                <MenuFlyoutItem.Icon>
                                                                    <FontIcon Glyph="&#xE8C8;" />
                                                                </MenuFlyoutItem.Icon>
                                                            </MenuFlyoutItem>
                                                            <MenuFlyoutItem Text="Star" Click="ContextMenu_Star_Click">
                                                                <MenuFlyoutItem.Icon>
                                                                    <FontIcon Glyph="&#xE734;" Foreground="#F59E0B" />
                                                                </MenuFlyoutItem.Icon>
                                                            </MenuFlyoutItem>
                                                            <MenuFlyoutItem Text="Rename..." Click="ContextMenu_Rename_Click">
                                                                <MenuFlyoutItem.Icon>
                                                                    <FontIcon Glyph="&#xE8AC;" />
                                                                </MenuFlyoutItem.Icon>
                                                            </MenuFlyoutItem>
                                                            <MenuFlyoutSeparator />
                                                            <MenuFlyoutItem Text="Cut (Ctrl+X)" Click="ContextMenu_CutFile_Click">
                                                                <MenuFlyoutItem.Icon>
                                                                    <FontIcon Glyph="&#xE8C6;" />
                                                                </MenuFlyoutItem.Icon>
                                                            </MenuFlyoutItem>
                                                            <MenuFlyoutItem Text="Copy (Ctrl+C)" Click="ContextMenu_CopyFile_Click">
                                                                <MenuFlyoutItem.Icon>
                                                                    <FontIcon Glyph="&#xE8C8;" />
                                                                </MenuFlyoutItem.Icon>
                                                            </MenuFlyoutItem>
                                                            <MenuFlyoutItem Text="Move to..." Click="ContextMenu_MoveItem_Click">
                                                                <MenuFlyoutItem.Icon>
                                                                    <FontIcon Glyph="&#xE8DE;" Foreground="#38BDF8" />
                                                                </MenuFlyoutItem.Icon>
                                                            </MenuFlyoutItem>
                                                            <MenuFlyoutSeparator />
                                                            <MenuFlyoutItem Text="Move to Trash" Click="ContextMenu_Trash_Click">
                                                                <MenuFlyoutItem.Icon>
                                                                    <FontIcon Glyph="&#xE74D;" Foreground="#F43F5E" />
                                                                </MenuFlyoutItem.Icon>
                                                            </MenuFlyoutItem>
                                                            <MenuFlyoutSeparator />
                                                            <MenuFlyoutItem Text="Properties" Click="ContextMenu_Properties_Click">
                                                                <MenuFlyoutItem.Icon>
                                                                    <FontIcon Glyph="&#xE946;" />
                                                                </MenuFlyoutItem.Icon>
                                                            </MenuFlyoutItem>
                                                        </MenuFlyout>
                                                    </Border.ContextFlyout>
                                                    <Grid RowSpacing="4">
                                                        <Grid.RowDefinitions>
                                                            <RowDefinition Height="*" />
                                                            <RowDefinition Height="Auto" />
                                                        </Grid.RowDefinitions>

                                                        <!-- Preview / Windows Shell Thumbnail Area -->
                                                        <Border
                                                            Grid.Row="0"
                                                            Background="{ThemeResource LayerFillColorDefaultBrush}"
                                                            CornerRadius="6">
                                                            <Grid HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                                                                <!-- Authentic Windows Shell Thumbnail or Icon -->
                                                                <Image
                                                                    x:Name="ThumbImage"
                                                                    HorizontalAlignment="Center"
                                                                    VerticalAlignment="Center"
                                                                    Source="{x:Bind EffectiveThumbnailUrl, Mode=OneWay}"
                                                                    Stretch="Uniform" />

                                                                <!-- Video Duration Badge (Top-Left) -->
                                                                <Border
                                                                    HorizontalAlignment="Left"
                                                                    VerticalAlignment="Top"
                                                                    Margin="4"
                                                                    Padding="4,1"
                                                                    CornerRadius="3"
                                                                    Background="#CC000000"
                                                                    Visibility="{x:Bind DurationVisibility, Mode=OneWay}">
                                                                    <TextBlock
                                                                        FontSize="9"
                                                                        FontWeight="SemiBold"
                                                                        Foreground="#F8FAFC"
                                                                        Text="{x:Bind FormattedDuration, Mode=OneWay}" />
                                                                </Border>

                                                                <!-- Video Format Badge (Top-Right) -->
                                                                <Border
                                                                    HorizontalAlignment="Right"
                                                                    VerticalAlignment="Top"
                                                                    Margin="4"
                                                                    Padding="4,1"
                                                                    CornerRadius="3"
                                                                    Background="#CC1E1B4B"
                                                                    BorderBrush="#4338CA"
                                                                    BorderThickness="1"
                                                                    Visibility="{x:Bind VideoBadgeVisibility, Mode=OneWay}">
                                                                    <TextBlock
                                                                        FontSize="8.5"
                                                                        FontWeight="Bold"
                                                                        Foreground="#A5B4FC"
                                                                        Text="{x:Bind VideoFormatBadge, Mode=OneWay}" />
                                                                </Border>

                                                                <!-- Selection Checkmark Badge (Top-Right overlay) -->
                                                                <Border
                                                                    HorizontalAlignment="Right"
                                                                    VerticalAlignment="Top"
                                                                    Margin="4"
                                                                    Width="18"
                                                                    Height="18"
                                                                    CornerRadius="9"
                                                                    Background="#38BDF8"
                                                                    Visibility="{x:Bind SelectionCheckmarkVisibility, Mode=OneWay}">
                                                                    <FontIcon
                                                                        Glyph="&#xE73E;"
                                                                        FontSize="10"
                                                                        Foreground="Black"
                                                                        HorizontalAlignment="Center"
                                                                        VerticalAlignment="Center" />
                                                                </Border>
                                                            </Grid>
                                                        </Border>

                                                        <!-- File Metadata & Actions -->
                                                        <StackPanel Grid.Row="1" Spacing="4">
                                                            <!-- Filename spanning full width (fixed height 28 for uniform vertical alignment) -->
                                                            <TextBlock
                                                                Height="28"
                                                                FontSize="11.5"
                                                                FontWeight="Medium"
                                                                MaxLines="2"
                                                                TextWrapping="Wrap"
                                                                Text="{x:Bind Name}"
                                                                TextTrimming="CharacterEllipsis"
                                                                VerticalAlignment="Top"
                                                                ToolTipService.ToolTip="{x:Bind Name}" />

                                                            <!-- Bottom Action Bar: Size (Left) + Actions (Right: Play + Download + Star) -->
                                                            <Grid VerticalAlignment="Center">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="*" />
                                                                    <ColumnDefinition Width="Auto" />
                                                                </Grid.ColumnDefinitions>

                                                                <TextBlock
                                                                    Grid.Column="0"
                                                                    FontSize="10"
                                                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                                    Text="{x:Bind FormattedSize}"
                                                                    VerticalAlignment="Center"
                                                                    TextTrimming="CharacterEllipsis" />

                                                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">
                                                                    <Button
                                                                        Width="20"
                                                                        Height="20"
                                                                        Padding="0"
                                                                        Background="Transparent"
                                                                        BorderThickness="0"
                                                                        CornerRadius="4"
                                                                        Click="FilePlayBtn_Click"
                                                                        Visibility="{x:Bind VideoBadgeVisibility, Mode=OneWay}"
                                                                        ToolTipService.ToolTip="Play / Stream in Browser">
                                                                        <FontIcon FontSize="9.5" Foreground="#A855F7" Glyph="&#xE768;" />
                                                                    </Button>
                                                                    <Button
                                                                        Width="20"
                                                                        Height="20"
                                                                        Padding="0"
                                                                        Background="Transparent"
                                                                        BorderThickness="0"
                                                                        CornerRadius="4"
                                                                        Click="FileDownloadBtn_Click"
                                                                        ToolTipService.ToolTip="Download Directly">
                                                                        <FontIcon FontSize="9.5" Foreground="#2DD4BF" Glyph="&#xE896;" />
                                                                    </Button>
                                                                    <Button
                                                                        Width="20"
                                                                        Height="20"
                                                                        Padding="0"
                                                                        Background="Transparent"
                                                                        BorderThickness="0"
                                                                        CornerRadius="4"
                                                                        Click="FileStarBtn_Click"
                                                                        ToolTipService.ToolTip="Star File">
                                                                        <FontIcon
                                                                            FontSize="9.5"
                                                                            Foreground="#F59E0B"
                                                                            Glyph="{x:Bind StarGlyph, Mode=OneWay}" />
                                                                    </Button>
                                                                </StackPanel>
                                                            </Grid>
                                                        </StackPanel>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </GridView.ItemTemplate>
                                    </GridView>
                                </StackPanel>

                                <!-- Files Section (List View) -->
                                <StackPanel x:Name="FilesListSection" Spacing="8" Visibility="Collapsed">
                                    <TextBlock
                                        FontSize="12"
                                        FontWeight="SemiBold"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Text="FILES" />
                                    <Grid Padding="12,0" ColumnSpacing="16" Margin="0,0,0,2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="20" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="150" />
                                            <ColumnDefinition Width="90" />
                                            <ColumnDefinition Width="80" />
                                            <ColumnDefinition Width="54" />
                                        </Grid.ColumnDefinitions>
                                        <Button x:Name="ListHeaderName" Grid.Column="1" Content="Name" Tag="name" Click="ListHeader_Click" Background="Transparent" BorderThickness="0" Padding="0,4" FontSize="11" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorSecondaryBrush}" HorizontalAlignment="Left" />
                                        <Button x:Name="ListHeaderDate" Grid.Column="2" Content="Modified" Tag="date" Click="ListHeader_Click" Background="Transparent" BorderThickness="0" Padding="0,4" FontSize="11" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorSecondaryBrush}" HorizontalAlignment="Left" />
                                        <Button x:Name="ListHeaderType" Grid.Column="3" Content="Type" Tag="type" Click="ListHeader_Click" Background="Transparent" BorderThickness="0" Padding="0,4" FontSize="11" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorSecondaryBrush}" HorizontalAlignment="Left" />
                                        <Button x:Name="ListHeaderSize" Grid.Column="4" Content="Size" Tag="size" Click="ListHeader_Click" Background="Transparent" BorderThickness="0" Padding="0,4" FontSize="11" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorSecondaryBrush}" HorizontalAlignment="Right" />
                                    </Grid>
                                    <ListView
                                        x:Name="FilesListView"
                                        DoubleTapped="FilesListView_DoubleTapped"
                                        SelectionMode="Extended"
                                        SelectionChanged="FilesListView_SelectionChanged"
                                        KeyDown="FilesOrFolders_KeyDown">
                                        <ListView.ItemContainerStyle>
                                            <Style TargetType="ListViewItem">
                                                <Setter Property="Padding" Value="0" />
                                                <Setter Property="MinHeight" Value="0" />
                                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                            </Style>
                                        </ListView.ItemContainerStyle>
                                        <ListView.ItemTemplate>
                                            <DataTemplate x:DataType="models:FileModel">
                                                <Border
                                                    Margin="0,0,0,4"
                                                    Padding="12,8"
                                                    Background="{x:Bind SelectionBackground, Mode=OneWay}"
                                                    BorderBrush="{x:Bind SelectionBorderBrush, Mode=OneWay}"
                                                    BorderThickness="{x:Bind SelectionBorderThickness, Mode=OneWay}"
                                                    CornerRadius="6">
                                                    <Border.ContextFlyout>
                                                        <MenuFlyout>
                                                            <MenuFlyoutItem Text="Download to Device" Click="ContextMenu_Download_Click">
                                                                <MenuFlyoutItem.Icon>
                                                                    <FontIcon Glyph="&#xE896;" Foreground="#2DD4BF" />
                                                                </MenuFlyoutItem.Icon>
                                                            </MenuFlyoutItem>
                                                            <MenuFlyoutItem Text="Copy ID" Click="ContextMenu_CopyId_Click">
                                                                <MenuFlyoutItem.Icon>
                                                                    <FontIcon Glyph="&#xE8C8;" />
                                                                </MenuFlyoutItem.Icon>
                                                            </MenuFlyoutItem>
                                                            <MenuFlyoutItem Text="Star" Click="ContextMenu_Star_Click">
                                                                <MenuFlyoutItem.Icon>
                                                                    <FontIcon Glyph="&#xE734;" Foreground="#F59E0B" />
                                                                </MenuFlyoutItem.Icon>
                                                            </MenuFlyoutItem>
                                                            <MenuFlyoutItem Text="Rename..." Click="ContextMenu_Rename_Click">
                                                                <MenuFlyoutItem.Icon>
                                                                    <FontIcon Glyph="&#xE8AC;" />
                                                                </MenuFlyoutItem.Icon>
                                                            </MenuFlyoutItem>
                                                            <MenuFlyoutSeparator />
                                                            <MenuFlyoutItem Text="Cut (Ctrl+X)" Click="ContextMenu_CutFile_Click">
                                                                <MenuFlyoutItem.Icon>
                                                                    <FontIcon Glyph="&#xE8C6;" />
                                                                </MenuFlyoutItem.Icon>
                                                            </MenuFlyoutItem>
                                                            <MenuFlyoutItem Text="Copy (Ctrl+C)" Click="ContextMenu_CopyFile_Click">
                                                                <MenuFlyoutItem.Icon>
                                                                    <FontIcon Glyph="&#xE8C8;" />
                                                                </MenuFlyoutItem.Icon>
                                                            </MenuFlyoutItem>
                                                            <MenuFlyoutItem Text="Move to..." Click="ContextMenu_MoveItem_Click">
                                                                <MenuFlyoutItem.Icon>
                                                                    <FontIcon Glyph="&#xE8DE;" Foreground="#38BDF8" />
                                                                </MenuFlyoutItem.Icon>
                                                            </MenuFlyoutItem>
                                                            <MenuFlyoutSeparator />
                                                            <MenuFlyoutItem Text="Move to Trash" Click="ContextMenu_Trash_Click">
                                                                <MenuFlyoutItem.Icon>
                                                                    <FontIcon Glyph="&#xE74D;" Foreground="#F43F5E" />
                                                                </MenuFlyoutItem.Icon>
                                                            </MenuFlyoutItem>
                                                            <MenuFlyoutSeparator />
                                                            <MenuFlyoutItem Text="Properties" Click="ContextMenu_Properties_Click">
                                                                <MenuFlyoutItem.Icon>
                                                                    <FontIcon Glyph="&#xE946;" />
                                                                </MenuFlyoutItem.Icon>
                                                            </MenuFlyoutItem>
                                                        </MenuFlyout>
                                                    </Border.ContextFlyout>
                                                    <Grid ColumnSpacing="16">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="20" />
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="150" />
                                                            <ColumnDefinition Width="90" />
                                                            <ColumnDefinition Width="80" />
                                                            <ColumnDefinition Width="54" />
                                                        </Grid.ColumnDefinitions>

                                                        <FontIcon
                                                            Grid.Column="0"
                                                            FontSize="20"
                                                            Foreground="{x:Bind CategoryBrush}"
                                                            Glyph="{x:Bind CategoryGlyph}" />

                                                        <TextBlock
                                                            Grid.Column="1"
                                                            VerticalAlignment="Center"
                                                            FontWeight="Medium"
                                                            TextTrimming="CharacterEllipsis"
                                                            ToolTipService.ToolTip="{x:Bind Name}"
                                                            Text="{x:Bind Name}" />

                                                        <TextBlock
                                                            Grid.Column="2"
                                                            VerticalAlignment="Center"
                                                            FontSize="12"
                                                            TextTrimming="CharacterEllipsis"
                                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                            Text="{x:Bind FormattedDate}" />

                                                        <TextBlock
                                                            Grid.Column="3"
                                                            VerticalAlignment="Center"
                                                            FontSize="12"
                                                            TextTrimming="CharacterEllipsis"
                                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                            Text="{x:Bind Category}" />

                                                        <TextBlock
                                                            Grid.Column="4"
                                                            VerticalAlignment="Center"
                                                            HorizontalAlignment="Right"
                                                            FontSize="12"
                                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                            Text="{x:Bind FormattedSize}" />

                                                        <StackPanel Grid.Column="5" Orientation="Horizontal" Spacing="4" HorizontalAlignment="Right">
                                                            <Button
                                                                Background="Transparent"
                                                                BorderThickness="0"
                                                                Padding="4"
                                                                Click="FileDownloadBtn_Click"
                                                                ToolTipService.ToolTip="Download Directly">
                                                                <FontIcon FontSize="13" Foreground="#2DD4BF" Glyph="&#xE896;" />
                                                            </Button>
                                                            <Button
                                                                Background="Transparent"
                                                                BorderThickness="0"
                                                                Padding="4"
                                                                Click="FileStarBtn_Click"
                                                                ToolTipService.ToolTip="Star File">
                                                                <FontIcon
                                                                    FontSize="13"
                                                                    Foreground="#F59E0B"
                                                                    Glyph="{x:Bind StarGlyph, Mode=OneWay}" />
                                                            </Button>
                                                        </StackPanel>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ListView.ItemTemplate>
                                    </ListView>
                                </StackPanel>

                                <!-- Empty State -->
                                <StackPanel
                                    x:Name="EmptyState"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Margin="0,64,0,0"
                                    Spacing="12"
                                    Visibility="Collapsed">
                                    <FontIcon x:Name="EmptyStateIcon" FontSize="56" Foreground="{ThemeResource TextFillColorTertiaryBrush}" Glyph="&#xE8B7;" />
                                    <TextBlock
                                        x:Name="EmptyStateTitle"
                                        FontSize="18"
                                        FontWeight="SemiBold"
                                        Text="This folder is empty" />
                                    <TextBlock
                                        x:Name="EmptyStateSubtitle"
                                        HorizontalAlignment="Center"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Text="Upload files or drag and drop items here to get started." />
                                </StackPanel>
                            </StackPanel>
                        </ScrollViewer>

                        <!-- Content Area: Recent Activity View -->
                        <ScrollViewer
                            x:Name="RecentView"
                            HorizontalScrollBarVisibility="Disabled"
                            VerticalScrollBarVisibility="Auto"
                            Padding="0,0,12,0"
                            Visibility="Collapsed">
                            <StackPanel Spacing="16">
                                <!-- Header & Switcher -->
                                <Grid RowSpacing="12">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <StackPanel Orientation="Horizontal" Spacing="12">
                                        <Border
                                            Background="{ThemeResource LayerFillColorDefaultBrush}"
                                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                            BorderThickness="1"
                                            CornerRadius="6"
                                            Padding="2">
                                            <StackPanel Orientation="Horizontal" Spacing="2">
                                                <Button
                                                    x:Name="RecentAllBtn"
                                                    Content="All Activity"
                                                    Padding="8,4"
                                                    Background="{ThemeResource AccentFillColorDefaultBrush}"
                                                    BorderThickness="0"
                                                    Foreground="Black"
                                                    Click="RecentAllBtn_Click" />
                                                <Button
                                                    x:Name="RecentFilesBtn"
                                                    Content="Telegram Files"
                                                    Padding="8,4"
                                                    Background="Transparent"
                                                    BorderThickness="0"
                                                    Click="RecentFilesBtn_Click" />
                                                <Button
                                                    x:Name="RecentDownloadsBtn"
                                                    Content="Downloads &amp; Uploads"
                                                    Padding="8,4"
                                                    Background="Transparent"
                                                    BorderThickness="0"
                                                    Click="RecentDownloadsBtn_Click" />
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>

                                    <StackPanel Grid.Row="1" HorizontalAlignment="Right" Orientation="Horizontal" Spacing="8" Margin="0,0,16,0">
                                        <Button Content="Clear Finished" Click="ClearFinishedDownloads_Click" />
                                        <Button Click="OpenDownloadsFolder_Click" AutomationProperties.Name="Open downloads folder" ToolTipService.ToolTip="Open downloads folder" ToolTipService.Placement="Bottom">
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <FontIcon Glyph="&#xE8B7;" FontSize="14" Foreground="#F59E0B" />
                                                <TextBlock Text="Downloads Folder" />
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>
                                </Grid>

                                <TextBlock x:Name="RecentFilesHeader" FontSize="12" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="RECENT FILES" Margin="4,0,0,-8" />
                                <ListView
                                    x:Name="RecentFilesListView"
                                    SelectionMode="None">
                                    <ListView.ItemTemplate>
                                        <DataTemplate x:DataType="models:FileModel">
                                            <Border
                                                Margin="0,0,0,6"
                                                Padding="14,10"
                                                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                                BorderThickness="1"
                                                CornerRadius="8">
                                                <Grid ColumnSpacing="14">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <FontIcon Grid.Column="0" VerticalAlignment="Center" FontSize="20" Foreground="{x:Bind CategoryBrush}" Glyph="{x:Bind CategoryGlyph}" />
                                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                                        <TextBlock FontWeight="Medium" Text="{x:Bind Name}" TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{x:Bind Name}" />
                                                        <TextBlock FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{x:Bind FormattedDate}" />
                                                    </StackPanel>
                                                    <TextBlock Grid.Column="2" VerticalAlignment="Center" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{x:Bind FormattedSize}" />
                                                    <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                                        <Button Background="Transparent" BorderThickness="0" Padding="6" Click="FileDownloadBtn_Click" ToolTipService.ToolTip="Download">
                                                            <FontIcon FontSize="13" Foreground="#2DD4BF" Glyph="&#xE896;" />
                                                        </Button>
                                                        <Button Background="Transparent" BorderThickness="0" Padding="6" Click="FileStarBtn_Click" ToolTipService.ToolTip="Star">
                                                            <FontIcon FontSize="13" Foreground="#F59E0B" Glyph="{x:Bind StarGlyph, Mode=OneWay}" />
                                                        </Button>
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ListView.ItemTemplate>
                                </ListView>

                                <TextBlock x:Name="RecentTransfersHeader" FontSize="12" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="DOWNLOADS &amp; UPLOADS" Margin="4,0,0,-8" />
                                <ListView
                                    x:Name="RecentDownloadsListView"
                                    SelectionMode="None">
                                    <ListView.ItemTemplate>
                                        <DataTemplate x:DataType="models:TransferTaskModel">
                                            <Border
                                                Margin="0,0,0,8"
                                                Padding="16,14"
                                                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                                BorderThickness="1"
                                                CornerRadius="8">
                                                <Grid ColumnSpacing="16" VerticalAlignment="Center">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>

                                                    <!-- Status Icon -->
                                                    <FontIcon
                                                        Grid.Column="0"
                                                        VerticalAlignment="Center"
                                                        FontSize="22"
                                                        Foreground="{x:Bind StatusBrush, Mode=OneWay}"
                                                        Glyph="{x:Bind StatusGlyph, Mode=OneWay}" />

                                                    <!-- File & Progress Info -->
                                                    <StackPanel Grid.Column="1" Spacing="6" VerticalAlignment="Center">
                                                        <!-- Top line: Left has Name, Badge, Status; Right has SpeedSummary / Phase info -->
                                                        <Grid ColumnSpacing="12">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="Auto" />
                                                            </Grid.ColumnDefinitions>

                                                            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                                                <TextBlock
                                                                    FontWeight="SemiBold"
                                                                    FontSize="13"
                                                                    Text="{x:Bind Name}"
                                                                    TextTrimming="CharacterEllipsis"
                                                                    MaxLines="1" />
                                                                <Border
                                                                    Padding="6,1.5"
                                                                    CornerRadius="4"
                                                                    Background="{ThemeResource LayerFillColorDefaultBrush}"
                                                                    VerticalAlignment="Center">
                                                                    <TextBlock
                                                                        FontSize="10"
                                                                        FontWeight="Bold"
                                                                        Foreground="{x:Bind TypeBadgeBrush, Mode=OneWay}"
                                                                        Text="{x:Bind TypeBadge, Mode=OneWay}" />
                                                                </Border>
                                                                <TextBlock
                                                                    FontSize="11"
                                                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                                    Text="{x:Bind DisplayStatus, Mode=OneWay}"
                                                                    VerticalAlignment="Center" />
                                                            </StackPanel>

                                                            <TextBlock
                                                                Grid.Column="1"
                                                                FontSize="11"
                                                                Foreground="{x:Bind StatusBrush, Mode=OneWay}"
                                                                Text="{x:Bind SpeedSummary, Mode=OneWay}"
                                                                VerticalAlignment="Center"
                                                                TextAlignment="Right" />
                                                        </Grid>

                                                        <!-- Full-width Progress Bar with visible track background -->
                                                        <ProgressBar
                                                            Height="4"
                                                            CornerRadius="2"
                                                            Background="{ThemeResource ControlStrokeColorDefaultBrush}"
                                                            Foreground="{x:Bind TypeBadgeBrush, Mode=OneWay}"
                                                            IsIndeterminate="{x:Bind IsProgressIndeterminate, Mode=OneWay}"
                                                            Value="{x:Bind ProgressPercentage, Mode=OneWay}"
                                                            Maximum="100" />

                                                        <!-- Bottom Line: Progress Summary Detail -->
                                                        <TextBlock
                                                            FontSize="11"
                                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                            Text="{x:Bind ProgressSummary, Mode=OneWay}"
                                                            TextTrimming="CharacterEllipsis" />
                                                    </StackPanel>

                                                    <!-- Action Buttons -->
                                                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                                        <Button
                                                            Content="Open File"
                                                            Visibility="{x:Bind CanOpenVisibility, Mode=OneWay}"
                                                            Click="OpenDownloadedFile_Click" />
                                                        <Button
                                                            Content="Reveal"
                                                            Visibility="{x:Bind CanOpenVisibility, Mode=OneWay}"
                                                            Click="RevealDownloadedFile_Click" />
                                                        <Button
                                                            Content="Pause"
                                                            Visibility="{x:Bind CanPauseVisibility, Mode=OneWay}"
                                                            Click="PauseDownload_Click" />
                                                        <Button
                                                            Content="Resume"
                                                            Visibility="{x:Bind PausedVisibility, Mode=OneWay}"
                                                            Click="ResumeDownload_Click" />
                                                        <Button
                                                            Content="Cancel"
                                                            Visibility="{x:Bind NotDoneVisibility, Mode=OneWay}"
                                                            Click="CancelTransfer_Click" />
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ListView.ItemTemplate>
                                </ListView>

                                <StackPanel x:Name="RecentEmptyState" HorizontalAlignment="Center" Spacing="10" Margin="0,64,0,0" Visibility="Collapsed">
                                    <FontIcon FontSize="48" Foreground="{ThemeResource TextFillColorTertiaryBrush}" Glyph="&#xE823;" HorizontalAlignment="Center" />
                                    <TextBlock FontSize="16" FontWeight="SemiBold" Text="No recent activity yet" HorizontalAlignment="Center" />
                                    <TextBlock FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="Files you upload or download will show up here." HorizontalAlignment="Center" />
                                </StackPanel>
                            </StackPanel>
                        </ScrollViewer>

                        <!-- Content Area: Dedicated Transfers Hub View -->
                        <ScrollViewer
                            x:Name="TransfersView"
                            HorizontalScrollBarVisibility="Disabled"
                            VerticalScrollBarVisibility="Auto"
                            Padding="0,0,12,0"
                            Visibility="Collapsed">
                            <StackPanel Spacing="12">
                                <!-- Header Subtitle -->
                                <TextBlock
                                    FontSize="12"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Text="Transfer activity with Telegram storage" />

                                <!-- Unified Toolbar: Filter Chips on Left, Actions on Right -->
                                <Grid Margin="0,0,16,4" VerticalAlignment="Center">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <!-- Filter Chips -->
                                    <Border
                                        Grid.Column="0"
                                        HorizontalAlignment="Left"
                                        VerticalAlignment="Center"
                                        Background="{ThemeResource LayerFillColorDefaultBrush}"
                                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                        BorderThickness="1"
                                        CornerRadius="6"
                                        Padding="2">
                                        <StackPanel Orientation="Horizontal" Spacing="2">
                                            <Button
                                                x:Name="TransfersAllBtn"
                                                Content="All Transfers"
                                                Padding="12,5"
                                                Background="{ThemeResource AccentFillColorDefaultBrush}"
                                                BorderThickness="0"
                                                Foreground="Black"
                                                Click="TransfersAllBtn_Click" />
                                            <Button
                                                x:Name="TransfersActiveBtn"
                                                Content="Active"
                                                Padding="12,5"
                                                Background="Transparent"
                                                BorderThickness="0"
                                                Click="TransfersActiveBtn_Click" />
                                            <Button
                                                x:Name="TransfersUploadsBtn"
                                                Content="Uploads"
                                                Padding="12,5"
                                                Background="Transparent"
                                                BorderThickness="0"
                                                Click="TransfersUploadsBtn_Click" />
                                            <Button
                                                x:Name="TransfersDownloadsBtn"
                                                Content="Downloads"
                                                Padding="12,5"
                                                Background="Transparent"
                                                BorderThickness="0"
                                                Click="TransfersDownloadsBtn_Click" />
                                            <Button
                                                x:Name="TransfersCompletedBtn"
                                                Content="Completed"
                                                Padding="12,5"
                                                Background="Transparent"
                                                BorderThickness="0"
                                                Click="TransfersCompletedBtn_Click" />
                                        </StackPanel>
                                    </Border>

                                    <!-- Action Buttons -->
                                    <StackPanel Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Center" Orientation="Horizontal" Spacing="8">
                                        <Button Content="Clear Finished" Click="ClearFinishedDownloads_Click" />
                                        <Button Click="OpenDownloadsFolder_Click" AutomationProperties.Name="Open downloads folder" ToolTipService.ToolTip="Open downloads folder" ToolTipService.Placement="Bottom">
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <FontIcon Glyph="&#xE8B7;" FontSize="14" Foreground="#F59E0B" />
                                                <TextBlock Text="Downloads Folder" />
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>
                                </Grid>

                                <!-- Transfers Empty State -->
                                <StackPanel
                                    x:Name="TransfersEmptyState"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Margin="0,48,0,0"
                                    Spacing="12"
                                    Visibility="Collapsed">
                                    <FontIcon FontSize="48" Foreground="{ThemeResource TextFillColorTertiaryBrush}" Glyph="&#xE896;" />
                                    <TextBlock
                                        FontSize="16"
                                        FontWeight="SemiBold"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        HorizontalAlignment="Center"
                                        Text="No transfers" />
                                    <TextBlock
                                        FontSize="12"
                                        Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                        HorizontalAlignment="Center"
                                        Text="Drop files onto TeleDrive or click Upload to transfer to Telegram storage" />
                                </StackPanel>

                                <!-- Transfers Hub ListView -->
                                <ListView
                                    x:Name="TransfersListView"
                                    SelectionMode="None">
                                    <ListView.ItemTemplate>
                                        <DataTemplate x:DataType="models:TransferTaskModel">
                                            <Border
                                                Margin="0,0,0,8"
                                                Padding="16,14"
                                                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                                BorderThickness="1"
                                                CornerRadius="8">
                                                <Grid ColumnSpacing="16" VerticalAlignment="Center">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>

                                                    <!-- Status Icon -->
                                                    <FontIcon
                                                        Grid.Column="0"
                                                        VerticalAlignment="Center"
                                                        FontSize="22"
                                                        Foreground="{x:Bind StatusBrush, Mode=OneWay}"
                                                        Glyph="{x:Bind StatusGlyph, Mode=OneWay}" />

                                                    <!-- File & Progress Info -->
                                                    <StackPanel Grid.Column="1" Spacing="6" VerticalAlignment="Center">
                                                        <!-- Top line: Left has Name, Badge, Status; Right has SpeedSummary / Phase info -->
                                                        <Grid ColumnSpacing="12">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="Auto" />
                                                            </Grid.ColumnDefinitions>

                                                            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                                                <TextBlock
                                                                    FontWeight="SemiBold"
                                                                    FontSize="13"
                                                                    Text="{x:Bind Name}"
                                                                    TextTrimming="CharacterEllipsis"
                                                                    MaxLines="1" />
                                                                <Border
                                                                    Padding="6,1.5"
                                                                    CornerRadius="4"
                                                                    Background="{ThemeResource LayerFillColorDefaultBrush}"
                                                                    VerticalAlignment="Center">
                                                                    <TextBlock
                                                                        FontSize="10"
                                                                        FontWeight="Bold"
                                                                        Foreground="{x:Bind TypeBadgeBrush, Mode=OneWay}"
                                                                        Text="{x:Bind TypeBadge, Mode=OneWay}" />
                                                                </Border>
                                                                <TextBlock
                                                                    FontSize="11"
                                                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                                    Text="{x:Bind DisplayStatus, Mode=OneWay}"
                                                                    VerticalAlignment="Center" />
                                                            </StackPanel>

                                                            <TextBlock
                                                                Grid.Column="1"
                                                                FontSize="11"
                                                                Foreground="{x:Bind StatusBrush, Mode=OneWay}"
                                                                Text="{x:Bind SpeedSummary, Mode=OneWay}"
                                                                VerticalAlignment="Center"
                                                                TextAlignment="Right" />
                                                        </Grid>

                                                        <!-- Full-width Progress Bar with visible track background -->
                                                        <ProgressBar
                                                            Height="4"
                                                            CornerRadius="2"
                                                            Background="{ThemeResource ControlStrokeColorDefaultBrush}"
                                                            Foreground="{x:Bind TypeBadgeBrush, Mode=OneWay}"
                                                            IsIndeterminate="{x:Bind IsProgressIndeterminate, Mode=OneWay}"
                                                            Value="{x:Bind ProgressPercentage, Mode=OneWay}"
                                                            Maximum="100" />

                                                        <!-- Bottom Line: Progress Summary Detail -->
                                                        <TextBlock
                                                            FontSize="11"
                                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                            Text="{x:Bind ProgressSummary, Mode=OneWay}"
                                                            TextTrimming="CharacterEllipsis" />
                                                    </StackPanel>

                                                    <!-- Action Buttons -->
                                                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                                        <Button
                                                            Content="Open"
                                                            Visibility="{x:Bind CanOpenVisibility, Mode=OneWay}"
                                                            Click="OpenDownloadedFile_Click" />
                                                        <Button
                                                            Content="Reveal"
                                                            Visibility="{x:Bind CanOpenVisibility, Mode=OneWay}"
                                                            Click="RevealDownloadedFile_Click" />
                                                        <Button
                                                            Content="Pause"
                                                            Visibility="{x:Bind CanPauseVisibility, Mode=OneWay}"
                                                            Click="PauseDownload_Click" />
                                                        <Button
                                                            Content="Resume"
                                                            Visibility="{x:Bind PausedVisibility, Mode=OneWay}"
                                                            Click="ResumeDownload_Click" />
                                                        <Button
                                                            Content="Cancel"
                                                            Visibility="{x:Bind NotDoneVisibility, Mode=OneWay}"
                                                            Click="CancelTransfer_Click" />
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ListView.ItemTemplate>
                                </ListView>
                            </StackPanel>
                        </ScrollViewer>
                        <!-- Content Area: Settings View -->
                        <ScrollViewer
                            x:Name="SettingsView"
                            HorizontalScrollBarVisibility="Disabled"
                            VerticalScrollBarVisibility="Auto"
                            Visibility="Collapsed">
                            <StackPanel MaxWidth="800" HorizontalAlignment="Left" Spacing="18" Padding="0,0,24,24">
                                <!-- Settings Subtitle (Page title 'Settings' is prominently displayed in the main top header) -->
                                <TextBlock Text="Configure display scales, card sizes, local cache, and system diagnostics." FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Margin="0,0,0,4" />

                                <!-- Appearance & Display Card -->
                                <Border
                                    Padding="18"
                                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1"
                                    CornerRadius="8">
                                    <StackPanel Spacing="16">
                                        <TextBlock Text="APPEARANCE &amp; DISPLAY" FontSize="11" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        
                                        <Grid ColumnSpacing="16">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                <TextBlock Text="Card Scale &amp; Tile Size" FontWeight="Medium" FontSize="13" />
                                                <TextBlock Text="Control how large folders and files appear in the grid view" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                                            </StackPanel>
                                            <ComboBox Grid.Column="1" x:Name="SettingsCardSizeCombo" Width="210" VerticalAlignment="Center" SelectionChanged="SettingsCardSizeCombo_SelectionChanged">
                                                <ComboBoxItem Content="Tiny (116px)" Tag="96" />
                                                <ComboBoxItem Content="Mini / Ultra Compact (130px)" Tag="130" />
                                                <ComboBoxItem Content="Compact (165px)" Tag="165" />
                                                <ComboBoxItem Content="Medium / Standard (205px)" Tag="205" />
                                                <ComboBoxItem Content="Large (265px)" Tag="265" />
                                            </ComboBox>
                                        </Grid>

                                        <MenuFlyoutSeparator />

                                        <Grid ColumnSpacing="16">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                <TextBlock Text="Default View Mode" FontWeight="Medium" FontSize="13" />
                                                <TextBlock Text="Initial display mode for directories" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                                            </StackPanel>
                                            <ComboBox Grid.Column="1" x:Name="SettingsViewModeCombo" Width="210" VerticalAlignment="Center" SelectionChanged="SettingsViewModeCombo_SelectionChanged">
                                                <ComboBoxItem Content="Grid View" Tag="0" />
                                                <ComboBoxItem Content="List View" Tag="1" />
                                            </ComboBox>
                                        </Grid>

                                        <MenuFlyoutSeparator />

                                        <Grid ColumnSpacing="16">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                <TextBlock Text="App Theme" FontWeight="Medium" FontSize="13" />
                                                <TextBlock Text="Select dark, light, or Windows system default theme" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                                            </StackPanel>
                                            <ComboBox Grid.Column="1" x:Name="SettingsThemeCombo" Width="210" VerticalAlignment="Center" SelectionChanged="SettingsThemeCombo_SelectionChanged">
                                                <ComboBoxItem Content="System (Follow Windows)" Tag="Default" />
                                                <ComboBoxItem Content="Dark Mode" Tag="Dark" />
                                                <ComboBoxItem Content="Light Mode" Tag="Light" />
                                            </ComboBox>
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <!-- Windows File Explorer Integration -->
                                <Border
                                    Padding="18"
                                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1"
                                    CornerRadius="8">
                                    <StackPanel Spacing="16">
                                        <TextBlock Text="WINDOWS FILE EXPLORER INTEGRATION" FontSize="11" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

                                        <Grid ColumnSpacing="16">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                <TextBlock Text="Right-Click Context Menu" FontWeight="Medium" FontSize="13" />
                                                <TextBlock Text="Show 'Upload to TeleDrive' when right-clicking any file, folder, or directory background in File Explorer" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                                            </StackPanel>
                                            <ToggleSwitch Grid.Column="1" x:Name="ShellContextMenuToggle" OnContent="Enabled" OffContent="Disabled" VerticalAlignment="Center" Toggled="ShellContextMenuToggle_Toggled" />
                                        </Grid>

                                        <MenuFlyoutSeparator />

                                        <Grid ColumnSpacing="16">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                <TextBlock Text="Send To Menu &amp; URL Protocol" FontWeight="Medium" FontSize="13" />
                                                <TextBlock Text="Integrate with Windows 'Send to' menu and teledrive:// browser links" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                                            </StackPanel>
                                            <Button Grid.Column="1" VerticalAlignment="Center" Click="RegisterShellBtn_Click">
                                                <StackPanel Orientation="Horizontal" Spacing="6">
                                                    <FontIcon Glyph="&#xE777;" FontSize="12" />
                                                    <TextBlock Text="Register Shell Now" />
                                                </StackPanel>
                                            </Button>
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <!-- Storage & Local Cache -->
                                <Border
                                    Padding="18"
                                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1"
                                    CornerRadius="8">
                                    <StackPanel Spacing="16">
                                        <TextBlock Text="STORAGE &amp; LOCAL CACHE" FontSize="11" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

                                        <Grid ColumnSpacing="16">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                <TextBlock Text="Downloads Folder" FontWeight="Medium" FontSize="13" />
                                                <TextBlock Text="Saved destination for downloaded files" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                                            </StackPanel>
                                            <Button Grid.Column="1" VerticalAlignment="Center" Click="OpenDownloadsFolder_Click">
                                                <StackPanel Orientation="Horizontal" Spacing="6">
                                                    <FontIcon Glyph="&#xED25;" FontSize="12" />
                                                    <TextBlock Text="Open in Explorer" />
                                                </StackPanel>
                                            </Button>
                                        </Grid>

                                        <MenuFlyoutSeparator />

                                        <Grid ColumnSpacing="16">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                <TextBlock Text="Thumbnail &amp; Shell Icon Cache" FontWeight="Medium" FontSize="13" />
                                                <TextBlock Text="Reset local high-DPI thumbnails and re-index shell icons" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                                            </StackPanel>
                                            <Button Grid.Column="1" VerticalAlignment="Center" Click="SettingsClearCacheBtn_Click">
                                                <StackPanel Orientation="Horizontal" Spacing="6">
                                                    <FontIcon Glyph="&#xE74D;" FontSize="12" />
                                                    <TextBlock Text="Clear Cache" />
                                                </StackPanel>
                                            </Button>
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <!-- System & Daemon Status -->
                                <Border
                                    Padding="18"
                                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1"
                                    CornerRadius="8">
                                    <StackPanel Spacing="14">
                                        <TextBlock Text="SYSTEM &amp; TELEGRAM BOT DAEMON" FontSize="11" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

                                        <Grid ColumnSpacing="16">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="Local TeleDrive service" FontSize="13" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                            <TextBlock x:Name="DaemonStatusText" Grid.Column="1" Text="Checking…" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontWeight="Medium" VerticalAlignment="Center" />
                                        </Grid>

                                        <Grid ColumnSpacing="16">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="Bundled Telegram Bot API (2 GB parts)" FontSize="13" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                            <TextBlock x:Name="BotApiStatusText" Grid.Column="1" Text="Checking…" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontWeight="Medium" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="320" />
                                        </Grid>

                                        <Grid ColumnSpacing="16">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="Desktop Runtime" FontSize="13" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Grid.Column="1" Text="Windows 11 x64 · Native WinUI 3 (.NET 8)" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                                        </Grid>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>

                    <!-- Right: File Details & Metadata Permanent Sidebar (matching Windows File Explorer) -->
                    <Border
                        x:Name="FileDetailsPane"
                        Grid.Column="1"
                        Width="320"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="10"
                        Visibility="Visible">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel Padding="16" Spacing="14">
                                <!-- Drawer Header -->
                                <Grid>
                                    <TextBlock Text="File Properties" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" />
                                    <Button
                                        HorizontalAlignment="Right"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        Padding="4"
                                        Click="CloseDetailsPane_Click"
                                        ToolTipService.ToolTip="Close Details">
                                        <FontIcon Glyph="&#xE711;" FontSize="11" />
                                    </Button>
                                </Grid>

                                <!-- Empty Selection Placeholder (File Explorer style) -->
                                <StackPanel
                                    x:Name="DetailsEmptyPlaceholder"
                                    Visibility="Collapsed"
                                    Spacing="12"
                                    Padding="16,40,16,20"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center">
                                    <FontIcon Glyph="&#xE9F5;" FontSize="48" Foreground="{ThemeResource TextFillColorTertiaryBrush}" HorizontalAlignment="Center" />
                                    <TextBlock
                                        Text="Select a file to preview"
                                        FontSize="15"
                                        FontWeight="SemiBold"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        HorizontalAlignment="Center" />
                                    <TextBlock
                                        Text="Choose an item to view its details, properties, and Telegram storage parts."
                                        FontSize="12"
                                        TextWrapping="Wrap"
                                        TextAlignment="Center"
                                        Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                        HorizontalAlignment="Center" />
                                </StackPanel>

                                <!-- Details Content Container -->
                                <StackPanel x:Name="DetailsContentStack" Spacing="14">
                                <!-- Visual Preview Card -->
                                <Border
                                    Height="160"
                                    Background="{ThemeResource LayerFillColorDefaultBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    Padding="8">
                                    <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <Image
                                            x:Name="DetailsThumbImage"
                                            MaxHeight="144"
                                            MaxWidth="280"
                                            Stretch="Uniform" />
                                        <FontIcon
                                            x:Name="DetailsFallbackIcon"
                                            FontSize="52"
                                            Visibility="Collapsed" />
                                    </Grid>
                                </Border>

                                <!-- File Title & Pill -->
                                <StackPanel Spacing="4">
                                    <TextBlock x:Name="DetailsFileName" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap" />
                                    <TextBlock x:Name="DetailsCategoryPill" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </StackPanel>

                                <!-- Quick Actions Toolbar -->
                                <StackPanel Spacing="6">
                                    <!-- Normal Mode Actions (Drive, Recent, Starred, Folders) -->
                                    <StackPanel x:Name="NormalDetailsActions" Spacing="6">
                                        <Button
                                            x:Name="DetailsDownloadBtn"
                                            HorizontalAlignment="Stretch"
                                            Height="34"
                                            Style="{StaticResource AccentButtonStyle}"
                                            Click="DetailsDownloadBtn_Click">
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <FontIcon Glyph="&#xE896;" FontSize="13" />
                                                <TextBlock Text="Download to Device" FontWeight="SemiBold" />
                                            </StackPanel>
                                        </Button>
                                        <Grid ColumnSpacing="6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>

                                            <Button
                                                Grid.Column="0"
                                                HorizontalAlignment="Stretch"
                                                Height="32"
                                                Padding="0"
                                                Click="DetailsStarBtn_Click"
                                                ToolTipService.ToolTip="Toggle Star">
                                                <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center">
                                                    <FontIcon x:Name="DetailsStarIcon" Glyph="&#xE734;" FontSize="11" Foreground="#F59E0B" />
                                                    <TextBlock x:Name="DetailsStarText" Text="Star" FontSize="11" />
                                                </StackPanel>
                                            </Button>
                                            <Button
                                                Grid.Column="1"
                                                HorizontalAlignment="Stretch"
                                                Height="32"
                                                Padding="0"
                                                Click="DetailsCopyIdBtn_Click"
                                                ToolTipService.ToolTip="Copy Cloud File ID">
                                                <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center">
                                                    <FontIcon Glyph="&#xE8C8;" FontSize="11" />
                                                    <TextBlock Text="Copy ID" FontSize="11" />
                                                </StackPanel>
                                            </Button>
                                            <Button
                                                x:Name="DetailsTrashBtn"
                                                Grid.Column="2"
                                                HorizontalAlignment="Stretch"
                                                Height="32"
                                                Padding="0"
                                                Click="DetailsTrashBtn_Click"
                                                ToolTipService.ToolTip="Move to Trash">
                                                <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center">
                                                    <FontIcon Glyph="&#xE74D;" FontSize="11" Foreground="#EF4444" />
                                                    <TextBlock Text="Trash" FontSize="11" Foreground="#EF4444" />
                                                </StackPanel>
                                            </Button>
                                        </Grid>
                                        <!-- Permanent Delete directly from cloud button -->
                                        <Button
                                            HorizontalAlignment="Stretch"
                                            Height="28"
                                            Padding="0"
                                            Background="Transparent"
                                            BorderThickness="0"
                                            Click="DetailsDeletePermanentlyBtn_Click"
                                            ToolTipService.ToolTip="Permanently delete without sending to trash">
                                            <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center">
                                                <FontIcon Glyph="&#xE74D;" FontSize="11" Foreground="#F87171" />
                                                <TextBlock Text="Delete Permanently" FontSize="11" Foreground="#F87171" />
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>

                                    <!-- Trash Mode Actions -->
                                    <StackPanel x:Name="TrashDetailsActions" Spacing="6" Visibility="Collapsed">
                                        <Button
                                            x:Name="DetailsRestoreBtn"
                                            HorizontalAlignment="Stretch"
                                            Height="34"
                                            Style="{StaticResource AccentButtonStyle}"
                                            Click="DetailsRestoreBtn_Click">
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <FontIcon Glyph="&#xE777;" FontSize="13" />
                                                <TextBlock Text="Restore to Drive" FontWeight="SemiBold" />
                                            </StackPanel>
                                        </Button>
                                        <Button
                                            x:Name="DetailsTrashPermanentDeleteBtn"
                                            HorizontalAlignment="Stretch"
                                            Height="34"
                                            Background="#DC2626"
                                            Foreground="White"
                                            Click="DetailsDeletePermanentlyBtn_Click"
                                            ToolTipService.ToolTip="Permanently delete from Telegram storage">
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <FontIcon Glyph="&#xE74D;" FontSize="13" />
                                                <TextBlock Text="Delete Forever" FontWeight="SemiBold" />
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>
                                </StackPanel>

                                <MenuFlyoutSeparator />

                                <!-- General Information -->
                                <TextBlock Text="FILE ATTRIBUTES" FontSize="11" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <StackPanel Spacing="8">
                                    <Grid>
                                        <TextBlock Text="Size" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        <TextBlock x:Name="DetailsFileSize" HorizontalAlignment="Right" FontSize="12" FontWeight="Medium" />
                                    </Grid>
                                    <Grid>
                                        <TextBlock Text="MIME Type" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        <TextBlock x:Name="DetailsMimeType" HorizontalAlignment="Right" FontSize="12" FontWeight="Medium" />
                                    </Grid>
                                    <Grid>
                                        <TextBlock Text="Modified" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        <TextBlock x:Name="DetailsModifiedDate" HorizontalAlignment="Right" FontSize="12" FontWeight="Medium" />
                                    </Grid>
                                    <Grid>
                                        <TextBlock Text="Created" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        <TextBlock x:Name="DetailsCreatedDate" HorizontalAlignment="Right" FontSize="12" FontWeight="Medium" />
                                    </Grid>
                                </StackPanel>

                                <!-- Media / EXIF / Technical Metadata -->
                                <StackPanel x:Name="DetailsMediaSection" Spacing="8" Visibility="Collapsed">
                                    <MenuFlyoutSeparator />
                                    <TextBlock Text="MEDIA &amp; METADATA" FontSize="11" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    <Grid x:Name="DetailsDimensionsRow">
                                        <TextBlock Text="Dimensions" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        <TextBlock x:Name="DetailsDimensionsText" HorizontalAlignment="Right" FontSize="12" FontWeight="Medium" />
                                    </Grid>
                                    <Grid x:Name="DetailsDurationRow">
                                        <TextBlock Text="Duration" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        <TextBlock x:Name="DetailsDurationText" HorizontalAlignment="Right" FontSize="12" FontWeight="Medium" />
                                    </Grid>
                                    <Grid x:Name="DetailsTakenAtRow">
                                        <TextBlock Text="Date Taken" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        <TextBlock x:Name="DetailsTakenAtText" HorizontalAlignment="Right" FontSize="12" FontWeight="Medium" />
                                    </Grid>
                                    <ItemsControl x:Name="DetailsMetadataItemsControl">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="models:MetadataEntry">
                                                <Grid Margin="0,3,0,0">
                                                    <TextBlock Text="{x:Bind Key}" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                    <TextBlock Text="{x:Bind Value}" HorizontalAlignment="Right" FontSize="12" FontWeight="Medium" />
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>

                                <MenuFlyoutSeparator />

                                <!-- Telegram storage parts -->
                                <TextBlock Text="TELEGRAM STORAGE" FontSize="11" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <StackPanel Spacing="8">
                                    <Grid>
                                        <TextBlock Text="Chunks" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        <TextBlock x:Name="DetailsPartsText" HorizontalAlignment="Right" FontSize="12" FontWeight="Medium" />
                                    </Grid>
                                    <Grid>
                                        <TextBlock Text="Security" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        <TextBlock Text="Private Telegram channel" HorizontalAlignment="Right" FontSize="12" FontWeight="Medium" Foreground="#10B981" />
                                    </Grid>
                                    <Grid>
                                        <TextBlock Text="File ID" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        <TextBlock x:Name="DetailsCloudIdText" HorizontalAlignment="Right" FontSize="11" TextTrimming="CharacterEllipsis" MaxWidth="170" />
                                    </Grid>
                                </StackPanel>
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>
                </Border>
                </Grid>

                <!-- Bottom Status Bar (matching Windows File Explorer) -->
                <Grid
                    Grid.Row="3"
                    Height="36"
                    Margin="0,8,0,0"
                    VerticalAlignment="Center">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- Left: Status Item & Selection Counts & Inline Transfer Widget -->
                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <TextBlock
                            x:Name="StatusBarItemCountText"
                            FontSize="12"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Text="0 items" />
                        <TextBlock
                            x:Name="StatusBarSelectionText"
                            FontSize="12"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Text="" />
                        <!-- Integrated Status Bar Transfer Indicator -->
                        <Button
                            x:Name="StatusBarTransferBtn"
                            Background="Transparent"
                            BorderThickness="0"
                            Padding="6,2"
                            Margin="6,0,0,0"
                            CornerRadius="4"
                            Visibility="Collapsed"
                            Click="StatusBarTransferBtn_Click"
                            ToolTipService.ToolTip="Click to open Transfers Hub">
                            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                <FontIcon x:Name="StatusBarTransferIcon" FontSize="11" Foreground="#2DD4BF" Glyph="&#xE896;" />
                                <TextBlock
                                    x:Name="StatusBarTransferText"
                                    FontSize="12"
                                    Foreground="#2DD4BF"
                                    Text="2 transfers active" />
                                <ProgressBar
                                    x:Name="StatusBarTransferProgress"
                                    Width="60"
                                    Height="4"
                                    CornerRadius="2"
                                    Maximum="100"
                                    Value="0"
                                    VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </StackPanel>

                    <!-- Right: Details Pane Toggle & View Mode Toggles -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <DropDownButton
                            x:Name="SortBtn"
                            Padding="8,4"
                            FontSize="12"
                            ToolTipService.ToolTip="Sort files"
                            AutomationProperties.Name="Sort files">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon Glyph="&#xE8CB;" FontSize="12" />
                                <TextBlock x:Name="SortBtnLabel" Text="Name" />
                            </StackPanel>
                            <DropDownButton.Flyout>
                                <MenuFlyout Placement="TopEdgeAlignedRight">
                                    <RadioMenuFlyoutItem x:Name="SortNameItem" Text="Name" GroupName="SortKey" Tag="name" Click="SortKey_Click" IsChecked="True" />
                                    <RadioMenuFlyoutItem x:Name="SortDateItem" Text="Date modified" GroupName="SortKey" Tag="date" Click="SortKey_Click" />
                                    <RadioMenuFlyoutItem x:Name="SortSizeItem" Text="Size" GroupName="SortKey" Tag="size" Click="SortKey_Click" />
                                    <RadioMenuFlyoutItem x:Name="SortTypeItem" Text="Type" GroupName="SortKey" Tag="type" Click="SortKey_Click" />
                                    <MenuFlyoutSeparator />
                                    <RadioMenuFlyoutItem x:Name="SortAscItem" Text="Ascending" GroupName="SortDir" Tag="asc" Click="SortDir_Click" IsChecked="True" />
                                    <RadioMenuFlyoutItem x:Name="SortDescItem" Text="Descending" GroupName="SortDir" Tag="desc" Click="SortDir_Click" />
                                </MenuFlyout>
                            </DropDownButton.Flyout>
                        </DropDownButton>
                        <Button
                            x:Name="ToggleDetailsPaneBtn"
                            Padding="6,4"
                            Background="{ThemeResource LayerFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="4"
                            Click="ToggleDetailsPaneBtn_Click"
                            ToolTipService.ToolTip="Show or hide the details pane" AutomationProperties.Name="Toggle details pane">
                            <FontIcon x:Name="ToggleDetailsPaneIcon" Glyph="&#xE946;" FontSize="13" />
                        </Button>

                        <Border
                            x:Name="ViewModeToggleBorder"
                            Background="{ThemeResource LayerFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="6"
                            Padding="2">
                            <StackPanel Orientation="Horizontal" Spacing="2">
                                <Button
                                    x:Name="GridViewBtn"
                                    Padding="6,4"
                                    Background="{ThemeResource AccentFillColorDefaultBrush}"
                                    BorderThickness="0"
                                    CornerRadius="4"
                                    Click="GridViewBtn_Click"
                                    ToolTipService.ToolTip="Grid / Large Icons">
                                    <FontIcon Glyph="&#xE80A;" FontSize="13" Foreground="Black" />
                                </Button>
                                <Button
                                    x:Name="ListViewBtn"
                                    Padding="6,4"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    CornerRadius="4"
                                    Click="ListViewBtn_Click"
                                    ToolTipService.ToolTip="Details / List View">
                                    <FontIcon Glyph="&#xE8FD;" FontSize="13" />
                                </Button>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>
            </Grid>
        </NavigationView>

        <!-- Transient notifications -->
        <InfoBar
            x:Name="ToastBar"
            IsOpen="False"
            IsClosable="True"
            HorizontalAlignment="Center"
            VerticalAlignment="Bottom"
            MaxWidth="520"
            Margin="0,0,0,64"
            Closed="ToastBar_Closed" />

        <!-- Drag & Drop Visual Overlay -->
        <Border
            x:Name="DragDropOverlay"
            Background="#A0000000"
            IsHitTestVisible="False"
            Visibility="Collapsed"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Stretch">
            <Border
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Padding="40,32"
                Background="{ThemeResource AcrylicInAppFillColorDefaultBrush}"
                BorderBrush="#2DD4BF"
                BorderThickness="2"
                CornerRadius="16">
                <StackPanel Spacing="14" HorizontalAlignment="Center">
                    <FontIcon FontSize="52" Foreground="#2DD4BF" Glyph="&#xE898;" />
                    <TextBlock
                        Text="Drop files or folders here"
                        FontSize="20"
                        FontWeight="SemiBold"
                        HorizontalAlignment="Center" />
                    <TextBlock
                        Text="Files will be ingested and uploaded directly to Telegram storage"
                        FontSize="13"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        HorizontalAlignment="Center" />
                </StackPanel>
            </Border>
        </Border>
    </Grid>
</Page>
