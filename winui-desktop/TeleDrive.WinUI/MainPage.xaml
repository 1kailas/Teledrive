                                                        <ProgressBar
                                                            Height="6"
                                                            CornerRadius="3"
                                                            Maximum="100"
                                                            Value="{x:Bind ProgressPercentage, Mode=OneWay}" />

                                                        <Grid>
                                                            <TextBlock
                                                                HorizontalAlignment="Left"
                                                                FontSize="11"
                                                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                                Text="{x:Bind ProgressSummary, Mode=OneWay}" />
                                                            <TextBlock
                                                                HorizontalAlignment="Right"
                                                                FontSize="11"
                                                                Foreground="{x:Bind StatusBrush, Mode=OneWay}"
                                                                Text="{x:Bind SpeedSummary, Mode=OneWay}" />
                                                        </Grid>
                                                    </StackPanel>

                                                    <!-- Action Buttons -->
                                                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                                        <Button
                                                            Content="Open File"
                                                            Visibility="{x:Bind CanOpenVisibility, Mode=OneWay}"
                                                            Click="OpenDownloadedFile_Click" />
                                                        <Button
                                                            Content="Reveal"
                                                            Visibility="{x:Bind CanOpenVisibility, Mode=OneWay}"
                                                            Click="RevealDownloadedFile_Click" />
                                                        <Button
                                                            Content="Pause"
                                                            Visibility="{x:Bind CanPauseVisibility, Mode=OneWay}"
                                                            Click="PauseDownload_Click" />
                                                        <Button
                                                            Content="Resume"
                                                            Visibility="{x:Bind PausedVisibility, Mode=OneWay}"
                                                            Click="ResumeDownload_Click" />
                                                        <Button
                                                            Content="Cancel"
                                                            Visibility="{x:Bind NotDoneVisibility, Mode=OneWay}"
                                                            Click="CancelTransfer_Click" />
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ListView.ItemTemplate>
                                </ListView>
                            </StackPanel>
                        </ScrollViewer>

                        <!-- Content Area: Dedicated Transfers Hub View -->
                        <ScrollViewer
                            x:Name="TransfersView"
                            HorizontalScrollBarVisibility="Disabled"
                            VerticalScrollBarVisibility="Auto"
                            Visibility="Collapsed">
                            <StackPanel Spacing="16">
                                <!-- Header & Actions -->
                                <Grid>
                                    <StackPanel Spacing="4">
                                        <TextBlock FontSize="20" FontWeight="SemiBold" Text="Transfers Hub" />
                                        <TextBlock
                                            FontSize="12"
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                            Text="Live direct upload &amp; download stream syncing with Telegram cloud" />
                                    </StackPanel>

                                    <StackPanel HorizontalAlignment="Right" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                        <Button Content="Clear Finished" Click="ClearFinishedDownloads_Click" />
                                        <Button Content="📁 Downloads Folder" Click="OpenDownloadsFolder_Click" />
                                    </StackPanel>
                                </Grid>

                                <!-- Filter Chips -->
                                <Border
                                    HorizontalAlignment="Left"
                                    Background="{ThemeResource LayerFillColorDefaultBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1"
                                    CornerRadius="6"
                                    Padding="2">
                                    <StackPanel Orientation="Horizontal" Spacing="2">
                                        <Button
                                            x:Name="TransfersAllBtn"
                                            Content="All Transfers"
                                            Padding="10,5"
                                            Background="{ThemeResource AccentFillColorDefaultBrush}"
                                            BorderThickness="0"
                                            Foreground="Black"
                                            Click="TransfersAllBtn_Click" />
                                        <Button
                                            x:Name="TransfersActiveBtn"
                                            Content="Active"
                                            Padding="10,5"
                                            Background="Transparent"
                                            BorderThickness="0"
                                            Click="TransfersActiveBtn_Click" />
                                        <Button
                                            x:Name="TransfersUploadsBtn"
                                            Content="Uploads"
                                            Padding="10,5"
                                            Background="Transparent"
                                            BorderThickness="0"
                                            Click="TransfersUploadsBtn_Click" />
                                        <Button
                                            x:Name="TransfersDownloadsBtn"
                                            Content="Downloads"
                                            Padding="10,5"
                                            Background="Transparent"
                                            BorderThickness="0"
                                            Click="TransfersDownloadsBtn_Click" />
                                        <Button
                                            x:Name="TransfersCompletedBtn"
                                            Content="Completed"
                                            Padding="10,5"
                                            Background="Transparent"
                                            BorderThickness="0"
                                            Click="TransfersCompletedBtn_Click" />
                                    </StackPanel>
                                </Border>

                                <!-- Transfers Empty State -->
                                <StackPanel
                                    x:Name="TransfersEmptyState"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Margin="0,48,0,0"
                                    Spacing="12"
                                    Visibility="Collapsed">
                                    <FontIcon FontSize="48" Foreground="{ThemeResource TextFillColorTertiaryBrush}" Glyph="&#xE896;" />
                                    <TextBlock
                                        FontSize="16"
                                        FontWeight="SemiBold"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        HorizontalAlignment="Center"
                                        Text="No transfers" />
                                    <TextBlock
                                        FontSize="12"
                                        Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                        HorizontalAlignment="Center"
                                        Text="Drop files onto TeleDrive or click Upload to transfer to cloud" />
                                </StackPanel>

                                <!-- Transfers Hub ListView -->
                                <ListView
                                    x:Name="TransfersListView"
                                    SelectionMode="None">
                                    <ListView.ItemTemplate>
                                        <DataTemplate x:DataType="models:TransferTaskModel">
                                            <Border
                                                Margin="0,0,0,8"
                                                Padding="14,12"
                                                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                                BorderThickness="1"
                                                CornerRadius="8">
                                                <Grid ColumnSpacing="16">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>

                                                    <!-- Status Icon -->
                                                    <FontIcon
                                                        Grid.Column="0"
                                                        VerticalAlignment="Center"
                                                        FontSize="22"
                                                        Foreground="{x:Bind StatusBrush, Mode=OneWay}"
                                                        Glyph="{x:Bind StatusGlyph, Mode=OneWay}" />

                                                    <!-- File & Progress Info -->
                                                    <StackPanel Grid.Column="1" Spacing="4">
                                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                                            <TextBlock FontWeight="SemiBold" Text="{x:Bind Name}" />
                                                            <Border
                                                                Padding="6,1"
                                                                CornerRadius="4"
                                                                Background="{ThemeResource LayerFillColorDefaultBrush}">
                                                                <TextBlock
                                                                    FontSize="10"
                                                                    FontWeight="Bold"
                                                                    Foreground="{x:Bind TypeBadgeBrush, Mode=OneWay}"
                                                                    Text="{x:Bind TypeBadge, Mode=OneWay}" />
                                                            </Border>
                                                            <TextBlock
                                                                FontSize="11"
                                                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                                Text="{x:Bind Status, Mode=OneWay}" />
                                                        </StackPanel>

                                                        <ProgressBar
                                                            Height="6"
                                                            CornerRadius="3"
                                                            Maximum="100"
                                                            Value="{x:Bind ProgressPercentage, Mode=OneWay}" />

                                                        <Grid>
                                                            <TextBlock
                                                                HorizontalAlignment="Left"
                                                                FontSize="11"
                                                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                                Text="{x:Bind ProgressSummary, Mode=OneWay}" />
                                                            <TextBlock
                                                                HorizontalAlignment="Right"
                                                                FontSize="11"
                                                                Foreground="{x:Bind StatusBrush, Mode=OneWay}"
                                                                Text="{x:Bind SpeedSummary, Mode=OneWay}" />
                                                        </Grid>
                                                    </StackPanel>

                                                    <!-- Action Buttons -->
                                                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                                        <Button
                                                            Content="Open"
                                                            Visibility="{x:Bind CanOpenVisibility, Mode=OneWay}"
                                                            Click="OpenDownloadedFile_Click" />
                                                        <Button
                                                            Content="Reveal"
                                                            Visibility="{x:Bind CanOpenVisibility, Mode=OneWay}"
                                                            Click="RevealDownloadedFile_Click" />
                                                        <Button
                                                            Content="Pause"
                                                            Visibility="{x:Bind CanPauseVisibility, Mode=OneWay}"
                                                            Click="PauseDownload_Click" />
                                                        <Button
                                                            Content="Resume"
                                                            Visibility="{x:Bind PausedVisibility, Mode=OneWay}"
                                                            Click="ResumeDownload_Click" />
