<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="TeleDrive_WinUI.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:TeleDrive_WinUI"
    xmlns:models="using:TeleDrive_WinUI.Models"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    KeyDown="MainPage_KeyDown">

    <Grid
        Background="{ThemeResource LayerFillColorDefaultBrush}"
        AllowDrop="True"
        DragOver="Common_DragOver"
        DragLeave="Common_DragLeave"
        Drop="Common_Drop">

        <!-- Windows 11 Fluent NavigationView -->
        <NavigationView
            x:Name="NavView"
            IsBackButtonVisible="Collapsed"
            IsSettingsVisible="True"
            OpenPaneLength="240"
            CompactPaneLength="48"
            PaneDisplayMode="Left"
            IsPaneOpen="True"
            CompactModeThresholdWidth="640"
            ExpandedModeThresholdWidth="1008"
            PaneOpened="NavView_PaneOpened"
            PaneClosed="NavView_PaneClosed"
            SelectionChanged="NavView_SelectionChanged"
            ItemInvoked="NavView_ItemInvoked">
            
            <NavigationView.MenuItems>
                <NavigationViewItem x:Name="DriveNavItem" Tag="drive" Content="My Drive">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE8B7;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Tag="folder_documents" Content="Documents">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE8A5;" Foreground="#10B981" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Tag="folder_pictures" Content="Pictures">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xEB9F;" Foreground="#38BDF8" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Tag="folder_videos" Content="Videos">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE714;" Foreground="#A855F7" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Tag="folder_music" Content="Music">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xEC4F;" Foreground="#EC4899" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>

                <NavigationViewItemSeparator />

                <NavigationViewItem Tag="starred" Content="Starred">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE734;" Foreground="#F59E0B" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Tag="recent" Content="Recent Activity">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE823;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>

                <NavigationViewItemSeparator />

                <NavigationViewItem x:Name="TransfersNavItem" Tag="transfers" Content="Transfers Hub">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE896;" Foreground="#2DD4BF" />
                    </NavigationViewItem.Icon>
                    <NavigationViewItem.InfoBadge>
                        <InfoBadge x:Name="TransfersBadge" Visibility="Collapsed" Value="0" />
                    </NavigationViewItem.InfoBadge>
                </NavigationViewItem>
                
                <NavigationViewItem Tag="trash" Content="Trash">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE74D;" Foreground="#EF4444" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.MenuItems>

            <!-- Main Content Area -->
            <Grid Padding="24,16,24,8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Top Command Bar / Toolbar -->
                <Grid Grid.Row="0" Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- Breadcrumbs & Title -->
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Spacing="6">
                        <Button
                            x:Name="NavBackBtn"
                            Background="Transparent"
                            BorderThickness="0"
                            Padding="6,4"
                            Click="NavBackBtn_Click"
                            Visibility="Collapsed"
                            ToolTipService.ToolTip="Back to My Drive">
                            <FontIcon Glyph="&#xE72B;" FontSize="14" />
                        </Button>
                        <StackPanel x:Name="BreadcrumbsBarStack" Orientation="Horizontal" VerticalAlignment="Center" Spacing="4">
                            <TextBlock
                                x:Name="CurrentFolderTitle"
                                FontSize="20"
                                FontWeight="SemiBold"
                                Text="My Drive" />
                        </StackPanel>
                        <TextBlock
                            x:Name="ItemCountSubtitle"
                            VerticalAlignment="Center"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Text="" />
                    </StackPanel>

                    <!-- Actions Bar -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                        <AutoSuggestBox
                            x:Name="SearchBox"
                            Width="200"
                            PlaceholderText="Search files..."
                            QueryIcon="Find"
                            TextChanged="SearchBox_TextChanged" />

                        <Button
                            x:Name="UploadFilesBtn"
                            Style="{StaticResource AccentButtonStyle}"
                            Click="UploadFilesBtn_Click">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon Glyph="&#xE898;" FontSize="14" />
                                <TextBlock Text="Upload Files" />
                            </StackPanel>
                        </Button>

                        <Button
                            x:Name="UploadFolderBtn"
                            Click="UploadFolderBtn_Click">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon Glyph="&#xED25;" FontSize="14" />
                                <TextBlock Text="Upload Folder" />
                            </StackPanel>
                        </Button>

                        <Button x:Name="NewFolderBtn" Click="NewFolderBtn_Click">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon Glyph="&#xE8F4;" FontSize="14" />
                                <TextBlock Text="New Folder" />
                            </StackPanel>
                        </Button>

                        <Button
                            x:Name="EmptyTrashBtn"
                            Style="{StaticResource AccentButtonStyle}"
                            Background="#DC2626"
                            Click="EmptyTrashBtn_Click"
                            Visibility="Collapsed"
                            ToolTipService.ToolTip="Permanently delete all items in trash and purge messages from Telegram cloud">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon Glyph="&#xE74D;" FontSize="14" />
                                <TextBlock Text="Empty Trash" />
                            </StackPanel>
                        </Button>

                        <Button ToolTipService.ToolTip="Refresh" Click="RefreshBtn_Click">
                            <FontIcon Glyph="&#xE72C;" FontSize="14" />
                        </Button>
                    </StackPanel>
                </Grid>

                <!-- Split Content: Files Area (Left) + Properties Drawer (Right) -->
                <Grid Grid.Row="1" ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- Left: Main Views Container -->
                    <Grid Grid.Column="0">
                        <!-- Content Area: Drive / Files View -->
                        <ScrollViewer
                            x:Name="DriveScrollViewer"
                            Padding="0,0,4,0"
                            Margin="0"
                            AllowDrop="True"
                            DragOver="Common_DragOver"
                            DragLeave="Common_DragLeave"
                            Drop="Common_Drop"
                            HorizontalScrollBarVisibility="Disabled"
                            VerticalScrollBarVisibility="Auto"
                            SizeChanged="DriveScrollViewer_SizeChanged"
                            Tapped="DriveScrollViewer_Tapped"
                            PointerWheelChanged="DriveScrollViewer_PointerWheelChanged">
                            <ScrollViewer.ContextFlyout>
                                <MenuFlyout>
                                    <MenuFlyoutItem Text="Upload Files..." Click="UploadFilesBtn_Click">
                                        <MenuFlyoutItem.Icon>
                                            <FontIcon Glyph="&#xE898;" Foreground="#38BDF8" />
                                        </MenuFlyoutItem.Icon>
                                    </MenuFlyoutItem>
                                    <MenuFlyoutItem Text="Upload Folder..." Click="UploadFolderBtn_Click">
                                        <MenuFlyoutItem.Icon>
                                            <FontIcon Glyph="&#xED25;" Foreground="#38BDF8" />
                                        </MenuFlyoutItem.Icon>
                                    </MenuFlyoutItem>
                                    <MenuFlyoutSeparator />
                                    <MenuFlyoutItem Text="New Folder..." Click="NewFolderBtn_Click">
                                        <MenuFlyoutItem.Icon>
                                            <FontIcon Glyph="&#xE8F4;" />
                                        </MenuFlyoutItem.Icon>
                                    </MenuFlyoutItem>
                                    <MenuFlyoutSeparator />
                                    <MenuFlyoutItem Text="Paste (Ctrl+V)" Click="ContextMenu_Paste_Click">
                                        <MenuFlyoutItem.Icon>
                                            <FontIcon Glyph="&#xE77F;" Foreground="#38BDF8" />
                                        </MenuFlyoutItem.Icon>
                                    </MenuFlyoutItem>
                                    <MenuFlyoutSeparator />
                                    <MenuFlyoutItem Text="Refresh (F5)" Click="RefreshBtn_Click">
                                        <MenuFlyoutItem.Icon>
                                            <FontIcon Glyph="&#xE72C;" />
                                        </MenuFlyoutItem.Icon>
                                    </MenuFlyoutItem>
                                </MenuFlyout>
                            </ScrollViewer.ContextFlyout>
                            <StackPanel Spacing="24">
                                <!-- Folders Section -->
                                <StackPanel x:Name="FoldersSection" Spacing="8">
                                    <TextBlock
                                        FontSize="12"
                                        FontWeight="SemiBold"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Text="FOLDERS" />
                                    <GridView
                                        x:Name="FoldersGridView"
                                        Padding="0"
                                        Margin="0"
                                        HorizontalAlignment="Left"
                                        DoubleTapped="FoldersGridView_DoubleTapped"
                                        SelectionMode="Extended"
                                        SelectionChanged="FoldersGridView_SelectionChanged"
                                        Loaded="FoldersGridView_Loaded"
                                        KeyDown="FilesOrFolders_KeyDown">
                                        <GridView.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <ItemsWrapGrid Orientation="Horizontal" HorizontalAlignment="Left" MaximumRowsOrColumns="-1" />
                                            </ItemsPanelTemplate>
                                        </GridView.ItemsPanel>
                                        <GridView.ItemContainerStyle>
                                            <Style TargetType="GridViewItem">
                                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                                <Setter Property="VerticalContentAlignment" Value="Stretch" />
                                                <Setter Property="Margin" Value="4" />
                                                <Setter Property="Padding" Value="0" />
                                            </Style>
                                        </GridView.ItemContainerStyle>
                                        <GridView.ItemTemplate>
                                            <DataTemplate x:DataType="models:FolderModel">
                                                <Border
                                                    Padding="10,6"
                                                    HorizontalAlignment="Stretch"
                                                    VerticalAlignment="Stretch"
                                                    Background="{x:Bind SelectionBackground, Mode=OneWay}"
                                                    BorderBrush="{x:Bind SelectionBorderBrush, Mode=OneWay}"
                                                    BorderThickness="{x:Bind SelectionBorderThickness, Mode=OneWay}"
                                                    CornerRadius="8">
                                                    <Border.ContextFlyout>
                                                        <MenuFlyout>
                                                            <MenuFlyoutItem Text="Open Folder" Click="ContextMenu_OpenFolder_Click">
                                                                <MenuFlyoutItem.Icon>
                                                                    <FontIcon Glyph="&#xE8DA;" Foreground="#38BDF8" />
                                                                </MenuFlyoutItem.Icon>
                                                            </MenuFlyoutItem>
                                                            <MenuFlyoutItem Text="Star" Click="FolderStarBtn_Click">
                                                                <MenuFlyoutItem.Icon>
                                                                    <FontIcon Glyph="&#xE734;" Foreground="#F59E0B" />
                                                                </MenuFlyoutItem.Icon>
                                                            </MenuFlyoutItem>
                                                            <MenuFlyoutItem Text="Rename..." Click="ContextMenu_RenameFolder_Click">
                                                                <MenuFlyoutItem.Icon>
                                                                    <FontIcon Glyph="&#xE8AC;" />
                                                                </MenuFlyoutItem.Icon>
                                                            </MenuFlyoutItem>
                                                            <MenuFlyoutSeparator />
                                                            <MenuFlyoutItem Text="Cut (Ctrl+X)" Click="ContextMenu_CutFolder_Click">
                                                                <MenuFlyoutItem.Icon>
                                                                    <FontIcon Glyph="&#xE8C6;" />
                                                                </MenuFlyoutItem.Icon>
                                                            </MenuFlyoutItem>
                                                            <MenuFlyoutItem Text="Copy (Ctrl+C)" Click="ContextMenu_CopyFolder_Click">
                                                                <MenuFlyoutItem.Icon>
                                                                    <FontIcon Glyph="&#xE8C8;" />
                                                                </MenuFlyoutItem.Icon>
                                                            </MenuFlyoutItem>
                                                            <MenuFlyoutItem Text="Move to..." Click="ContextMenu_MoveItem_Click">
                                                                <MenuFlyoutItem.Icon>
                                                                    <FontIcon Glyph="&#xE8DE;" Foreground="#38BDF8" />
                                                                </MenuFlyoutItem.Icon>
                                                            </MenuFlyoutItem>
                                                            <MenuFlyoutItem Text="Paste into folder" Click="ContextMenu_PasteIntoFolder_Click">
                                                                <MenuFlyoutItem.Icon>
                                                                    <FontIcon Glyph="&#xE77F;" Foreground="#38BDF8" />
                                                                </MenuFlyoutItem.Icon>
                                                            </MenuFlyoutItem>
                                                            <MenuFlyoutSeparator />
                                                            <MenuFlyoutItem Text="Move to Trash" Click="ContextMenu_TrashFolder_Click">
                                                                <MenuFlyoutItem.Icon>
                                                                    <FontIcon Glyph="&#xE74D;" Foreground="#F43F5E" />
                                                                </MenuFlyoutItem.Icon>
                                                            </MenuFlyoutItem>
                                                        </MenuFlyout>
                                                    </Border.ContextFlyout>
                                                    <Grid ColumnSpacing="8">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>

                                                        <FontIcon
                                                            Grid.Column="0"
                                                            FontSize="20"
                                                            Foreground="#F59E0B"
                                                            Glyph="&#xE8B7;" />

                                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                            <TextBlock
                                                                FontWeight="Medium"
                                                                FontSize="12"
                                                                MaxLines="1"
                                                                Text="{x:Bind Name}"
                                                                TextTrimming="CharacterEllipsis" />
                                                            <TextBlock
                                                                FontSize="10.5"
                                                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                                Text="{x:Bind FormattedItemCount}" />
                                                        </StackPanel>

                                                        <!-- Selection indicator checkmark badge -->
                                                        <Border
                                                            Grid.Column="2"
                                                            Width="16"
                                                            Height="16"
                                                            CornerRadius="8"
                                                            Background="#38BDF8"
                                                            Visibility="{x:Bind SelectionCheckmarkVisibility, Mode=OneWay}"
                                                            VerticalAlignment="Center">
                                                            <FontIcon
                                                                Glyph="&#xE73E;"
                                                                FontSize="9"
                                                                Foreground="Black"
                                                                HorizontalAlignment="Center"
                                                                VerticalAlignment="Center" />
                                                        </Border>

                                                        <Button
                                                            Grid.Column="3"
                                                            Width="22"
                                                            Height="22"
                                                            Background="Transparent"
                                                            BorderThickness="0"
                                                            Padding="0"
                                                            CornerRadius="4"
                                                            VerticalAlignment="Center"
                                                            Click="FolderStarBtn_Click">
                                                            <FontIcon
                                                                FontSize="10"
                                                                Foreground="#F59E0B"
                                                                Glyph="{x:Bind StarGlyph, Mode=OneWay}" />
                                                        </Button>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </GridView.ItemTemplate>
                                    </GridView>
                                </StackPanel>

                                <!-- Files Section (Grid View) -->
                                <StackPanel x:Name="FilesGridSection" Spacing="8">
                                    <TextBlock
                                        FontSize="12"
                                        FontWeight="SemiBold"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Text="FILES" />
                                    <GridView
                                        x:Name="FilesGridView"
                                        Padding="0"
                                        Margin="0"
                                        HorizontalAlignment="Left"
                                        AllowDrop="True"
                                        DragOver="Common_DragOver"
                                        DragLeave="Common_DragLeave"
                                        Drop="Common_Drop"
                                        DoubleTapped="FilesGridView_DoubleTapped"
                                        SelectionMode="Extended"
                                        SelectionChanged="FilesGridView_SelectionChanged"
                                        Loaded="FilesGridView_Loaded"
                                        KeyDown="FilesOrFolders_KeyDown">
                                        <GridView.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <ItemsWrapGrid Orientation="Horizontal" HorizontalAlignment="Left" MaximumRowsOrColumns="-1" />
                                            </ItemsPanelTemplate>
                                        </GridView.ItemsPanel>
                                        <GridView.ItemContainerStyle>
                                            <Style TargetType="GridViewItem">
                                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                                <Setter Property="VerticalContentAlignment" Value="Stretch" />
                                                <Setter Property="Margin" Value="4" />
                                                <Setter Property="Padding" Value="0" />
                                            </Style>
                                        </GridView.ItemContainerStyle>
                                        <GridView.ItemTemplate>
                                            <DataTemplate x:DataType="models:FileModel">
                                                <Border
                                                    HorizontalAlignment="Stretch"
                                                    VerticalAlignment="Stretch"
                                                    Padding="6"
                                                    Background="{x:Bind SelectionBackground, Mode=OneWay}"
                                                    BorderBrush="{x:Bind SelectionBorderBrush, Mode=OneWay}"
                                                    BorderThickness="{x:Bind SelectionBorderThickness, Mode=OneWay}"
                                                    CornerRadius="8">
                                                    <Border.ContextFlyout>
                                                        <MenuFlyout>
                                                            <MenuFlyoutItem Text="Download to Device" Click="ContextMenu_Download_Click">
                                                                <MenuFlyoutItem.Icon>
                                                                    <FontIcon Glyph="&#xE896;" Foreground="#2DD4BF" />
                                                                </MenuFlyoutItem.Icon>
                                                            </MenuFlyoutItem>
                                                            <MenuFlyoutItem Text="Copy ID" Click="ContextMenu_CopyId_Click">
                                                                <MenuFlyoutItem.Icon>
                                                                    <FontIcon Glyph="&#xE8C8;" />
                                                                </MenuFlyoutItem.Icon>
                                                            </MenuFlyoutItem>
                                                            <MenuFlyoutItem Text="Star" Click="ContextMenu_Star_Click">
                                                                <MenuFlyoutItem.Icon>
                                                                    <FontIcon Glyph="&#xE734;" Foreground="#F59E0B" />
                                                                </MenuFlyoutItem.Icon>
                                                            </MenuFlyoutItem>
                                                            <MenuFlyoutItem Text="Rename..." Click="ContextMenu_Rename_Click">
                                                                <MenuFlyoutItem.Icon>
                                                                    <FontIcon Glyph="&#xE8AC;" />
                                                                </MenuFlyoutItem.Icon>
                                                            </MenuFlyoutItem>
                                                            <MenuFlyoutSeparator />
                                                            <MenuFlyoutItem Text="Cut (Ctrl+X)" Click="ContextMenu_CutFile_Click">
                                                                <MenuFlyoutItem.Icon>
                                                                    <FontIcon Glyph="&#xE8C6;" />
                                                                </MenuFlyoutItem.Icon>
                                                            </MenuFlyoutItem>
                                                            <MenuFlyoutItem Text="Copy (Ctrl+C)" Click="ContextMenu_CopyFile_Click">
                                                                <MenuFlyoutItem.Icon>
                                                                    <FontIcon Glyph="&#xE8C8;" />
                                                                </MenuFlyoutItem.Icon>
                                                            </MenuFlyoutItem>
                                                            <MenuFlyoutItem Text="Move to..." Click="ContextMenu_MoveItem_Click">
                                                                <MenuFlyoutItem.Icon>
                                                                    <FontIcon Glyph="&#xE8DE;" Foreground="#38BDF8" />
                                                                </MenuFlyoutItem.Icon>
                                                            </MenuFlyoutItem>
                                                            <MenuFlyoutSeparator />
                                                            <MenuFlyoutItem Text="Move to Trash" Click="ContextMenu_Trash_Click">
                                                                <MenuFlyoutItem.Icon>
                                                                    <FontIcon Glyph="&#xE74D;" Foreground="#F43F5E" />
                                                                </MenuFlyoutItem.Icon>
                                                            </MenuFlyoutItem>
                                                            <MenuFlyoutSeparator />
                                                            <MenuFlyoutItem Text="Properties" Click="ContextMenu_Properties_Click">
                                                                <MenuFlyoutItem.Icon>
                                                                    <FontIcon Glyph="&#xE946;" />
                                                                </MenuFlyoutItem.Icon>
                                                            </MenuFlyoutItem>
                                                        </MenuFlyout>
                                                    </Border.ContextFlyout>
                                                    <Grid RowSpacing="4">
                                                        <Grid.RowDefinitions>
                                                            <RowDefinition Height="*" />
                                                            <RowDefinition Height="Auto" />
                                                        </Grid.RowDefinitions>

                                                        <!-- Preview / Windows Shell Thumbnail Area -->
                                                        <Border
                                                            Grid.Row="0"
                                                            Background="{ThemeResource LayerFillColorDefaultBrush}"
                                                            CornerRadius="6">
                                                            <Grid HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                                                                <!-- Authentic Windows Shell Thumbnail or Icon -->
                                                                <Image
                                                                    x:Name="ThumbImage"
                                                                    HorizontalAlignment="Center"
                                                                    VerticalAlignment="Center"
                                                                    Source="{x:Bind EffectiveThumbnailUrl, Mode=OneWay}"
                                                                    Stretch="Uniform" />

                                                                <!-- Selection Checkmark Badge (Top-Right) -->
                                                                <Border
                                                                    HorizontalAlignment="Right"
                                                                    VerticalAlignment="Top"
                                                                    Margin="4"
                                                                    Width="18"
                                                                    Height="18"
                                                                    CornerRadius="9"
                                                                    Background="#38BDF8"
                                                                    Visibility="{x:Bind SelectionCheckmarkVisibility, Mode=OneWay}">
                                                                    <FontIcon
                                                                        Glyph="&#xE73E;"
                                                                        FontSize="10"
                                                                        Foreground="Black"
                                                                        HorizontalAlignment="Center"
                                                                        VerticalAlignment="Center" />
                                                                </Border>
                                                            </Grid>
                                                        </Border>

                                                        <!-- File Metadata & Actions -->
                                                        <StackPanel Grid.Row="1" Spacing="4">
                                                            <!-- Filename spanning full width (fixed height 28 for uniform vertical alignment) -->
                                                            <TextBlock
                                                                Height="28"
                                                                FontSize="11.5"
                                                                FontWeight="Medium"
                                                                MaxLines="2"
                                                                TextWrapping="Wrap"
                                                                Text="{x:Bind Name}"
                                                                TextTrimming="CharacterEllipsis"
                                                                VerticalAlignment="Top"
                                                                ToolTipService.ToolTip="{x:Bind Name}" />

                                                            <!-- Bottom Action Bar: Size (Left) + 2 Action Buttons (Right: Download + Star) -->
                                                            <Grid VerticalAlignment="Center">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="*" />
                                                                    <ColumnDefinition Width="Auto" />
                                                                </Grid.ColumnDefinitions>

                                                                <TextBlock
                                                                    Grid.Column="0"
                                                                    FontSize="10"
                                                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                                    Text="{x:Bind FormattedSize}"
                                                                    VerticalAlignment="Center"
                                                                    TextTrimming="CharacterEllipsis" />

                                                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">
                                                                    <Button
                                                                        Width="20"
                                                                        Height="20"
                                                                        Padding="0"
                                                                        Background="Transparent"
                                                                        BorderThickness="0"
                                                                        CornerRadius="4"
                                                                        Click="FileDownloadBtn_Click"
                                                                        ToolTipService.ToolTip="Download Directly">
                                                                        <FontIcon FontSize="9.5" Foreground="#2DD4BF" Glyph="&#xE896;" />
                                                                    </Button>
                                                                    <Button
                                                                        Width="20"
                                                                        Height="20"
                                                                        Padding="0"
                                                                        Background="Transparent"
                                                                        BorderThickness="0"
                                                                        CornerRadius="4"
                                                                        Click="FileStarBtn_Click"
                                                                        ToolTipService.ToolTip="Star File">
                                                                        <FontIcon
                                                                            FontSize="9.5"
                                                                            Foreground="#F59E0B"
                                                                            Glyph="{x:Bind StarGlyph, Mode=OneWay}" />
                                                                    </Button>
                                                                </StackPanel>
                                                            </Grid>
                                                        </StackPanel>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </GridView.ItemTemplate>
                                    </GridView>
                                </StackPanel>

                                <!-- Files Section (List View) -->
                                <StackPanel x:Name="FilesListSection" Spacing="8" Visibility="Collapsed">
                                    <TextBlock
                                        FontSize="12"
                                        FontWeight="SemiBold"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Text="FILES" />
                                    <ListView
                                        x:Name="FilesListView"
                                        DoubleTapped="FilesListView_DoubleTapped"
                                        SelectionMode="Extended"
                                        SelectionChanged="FilesListView_SelectionChanged"
                                        KeyDown="FilesOrFolders_KeyDown">
                                        <ListView.ItemTemplate>
                                            <DataTemplate x:DataType="models:FileModel">
                                                <Border
                                                    Margin="0,0,0,4"
                                                    Padding="12,8"
                                                    Background="{x:Bind SelectionBackground, Mode=OneWay}"
                                                    BorderBrush="{x:Bind SelectionBorderBrush, Mode=OneWay}"
                                                    BorderThickness="{x:Bind SelectionBorderThickness, Mode=OneWay}"
                                                    CornerRadius="6">
                                                    <Border.ContextFlyout>
                                                        <MenuFlyout>
                                                            <MenuFlyoutItem Text="Download to Device" Click="ContextMenu_Download_Click">
                                                                <MenuFlyoutItem.Icon>
                                                                    <FontIcon Glyph="&#xE896;" Foreground="#2DD4BF" />
                                                                </MenuFlyoutItem.Icon>
                                                            </MenuFlyoutItem>
                                                            <MenuFlyoutItem Text="Copy ID" Click="ContextMenu_CopyId_Click">
                                                                <MenuFlyoutItem.Icon>
                                                                    <FontIcon Glyph="&#xE8C8;" />
                                                                </MenuFlyoutItem.Icon>
                                                            </MenuFlyoutItem>
                                                            <MenuFlyoutItem Text="Star" Click="ContextMenu_Star_Click">
                                                                <MenuFlyoutItem.Icon>
                                                                    <FontIcon Glyph="&#xE734;" Foreground="#F59E0B" />
                                                                </MenuFlyoutItem.Icon>
                                                            </MenuFlyoutItem>
                                                            <MenuFlyoutItem Text="Rename..." Click="ContextMenu_Rename_Click">
                                                                <MenuFlyoutItem.Icon>
                                                                    <FontIcon Glyph="&#xE8AC;" />
                                                                </MenuFlyoutItem.Icon>
                                                            </MenuFlyoutItem>
                                                            <MenuFlyoutSeparator />
                                                            <MenuFlyoutItem Text="Cut (Ctrl+X)" Click="ContextMenu_CutFile_Click">
                                                                <MenuFlyoutItem.Icon>
                                                                    <FontIcon Glyph="&#xE8C6;" />
                                                                </MenuFlyoutItem.Icon>
                                                            </MenuFlyoutItem>
                                                            <MenuFlyoutItem Text="Copy (Ctrl+C)" Click="ContextMenu_CopyFile_Click">
                                                                <MenuFlyoutItem.Icon>
                                                                    <FontIcon Glyph="&#xE8C8;" />
                                                                </MenuFlyoutItem.Icon>
                                                            </MenuFlyoutItem>
                                                            <MenuFlyoutItem Text="Move to..." Click="ContextMenu_MoveItem_Click">
