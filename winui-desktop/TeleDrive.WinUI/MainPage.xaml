                                        x:Name="EmptyStateSubtitle"
                                        HorizontalAlignment="Center"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Text="Upload files or drag and drop items here to get started." />
                                </StackPanel>
                            </StackPanel>
                        </ScrollViewer>

                        <!-- Content Area: Recent Activity View -->
                        <ScrollViewer
                            x:Name="RecentView"
