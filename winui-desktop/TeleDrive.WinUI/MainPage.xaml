                                                        <TextBlock
                                                            Grid.Column="1"
                                                            VerticalAlignment="Center"
                                                            FontWeight="Medium"
                                                            Text="{x:Bind Name}" />

                                                        <TextBlock
                                                            Grid.Column="2"
                                                            VerticalAlignment="Center"
                                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                            Text="{x:Bind Category}" />

                                                        <TextBlock
                                                            Grid.Column="3"
                                                            VerticalAlignment="Center"
                                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                            Text="{x:Bind FormattedSize}" />

                                                        <StackPanel Grid.Column="4" Orientation="Horizontal" Spacing="4">
                                                            <Button
                                                                Background="Transparent"
                                                                BorderThickness="0"
                                                                Padding="4"
                                                                Click="FileDownloadBtn_Click"
