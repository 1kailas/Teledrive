{
  "name": "server",
  "version": "3.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.build.json && node -e \"const fs=require('fs');fs.rmSync('dist/db/migrations',{recursive:true,force:true});fs.cpSync('src/db/migrations','dist/db/migrations',{recursive:true})\"",
    "start": "node dist/index.js",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "doctor": "tsx src/cli/doctor.ts",
    "bots:logout": "tsx src/cli/botsLogout.ts",
    "hash-password": "tsx src/cli/hashPassword.ts",
    "backup": "tsx src/cli/backup.ts",
    "mock:telegram": "tsx src/dev/mockBotApi.ts",
    "channel:find": "tsx src/cli/channelFind.ts"
  },
  "dependencies": {
    "@fastify/cookie": "11.1.0",
    "@fastify/helmet": "13.2.0",
    "@fastify/rate-limit": "11.2.1",
    "@fastify/static": "8.3.0",
    "archiver": "8.0.0",
    "better-sqlite3": "12.5.0",
    "dotenv": "18.0.9",
    "exif-reader": "2.0.3",
    "fastify": "5.12.7",
    "mime-types": "3.0.2",
    "music-metadata": "11.16.1",
    "pino": "10.4.0",
    "pino-pretty": "13.2.0",
    "sharp": "0.35.5",
    "undici": "7.30.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/archiver": "8.0.0",
    "@types/better-sqlite3": "9.6.0",
    "@types/mime-types": "3.0.1",
    "@types/node": "24.19.2",
    "@types/yauzl": "3.4.0",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "3.2.7",
    "yauzl": "3.4.0"
  }
}
